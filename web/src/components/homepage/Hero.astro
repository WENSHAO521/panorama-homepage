---
import { Image } from 'astro:assets';
import PhraseText from '@/components/ui/PhraseText.astro';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';
import { getActiveJournals, getFeaturedJournals, getJournalBySlug } from '@/lib/content/journals';
import { getAllImprints } from '@/lib/content/imprints';
import { getJournalCoverAsset } from '@/lib/assets/journalCovers';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

// Cover wall: the curated lead journal (featured flag, docs/HOMEPAGE.md
// §Featured journal selection) sits in the middle of the fan; the other four
// are Health Nexus and one title from each remaining imprint, in imprint order.
const [lead, ...others] = getFeaturedJournals();
const also = getJournalBySlug('healthnexus') ?? others[0];
const activeJournals = getActiveJournals();
const shownImprints = new Set([lead.imprint, also?.imprint]);
const rest = getAllImprints().flatMap((imprint) => {
  if (shownImprints.has(imprint.slug)) return [];
  const journal = activeJournals.find((j) => j.imprint === imprint.slug && getJournalCoverAsset(j.cover));
  return journal ? [journal] : [];
});
const ordered = [also, rest[0], lead, ...rest.slice(1)].filter((j): j is NonNullable<typeof j> => Boolean(j));
const wall = ordered.flatMap((journal) => {
  const cover = getJournalCoverAsset(journal.cover);
  return cover ? [{ journal, cover }] : [];
}).slice(0, 5);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container-wide hero__intro">
    <div>
      <p class="text-overline hero__eyebrow">{t('home.heroOverline')}</p>
      <h1 id="hero-title" class="hero__title"><PhraseText text={t('home.heroStatement')} locale={locale} /></h1>
    </div>
    <div class="hero__search">
      <form action={localizePath('/search/', locale)} method="get" role="search" class="hero__form">
        <label for="hero-search" class="visually-hidden">{t('home.searchLabel')}</label>
        <svg viewBox="0 0 17 17" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><circle cx="7.2" cy="7.2" r="5.2" /><path d="M11 11l4.5 4.5" /></svg>
        <input id="hero-search" name="q" type="search" placeholder={t('home.searchLabel')} autocomplete="off" />
        <button type="submit" aria-label={t('home.searchLabel')}>
          <svg viewBox="0 0 14 10" width="14" height="10" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d="M0 5h12M8 1l4 4-4 4" /></svg>
        </button>
      </form>
      <a class="action-link" href={localizePath('/journals/', locale)}>{t('common.browseJournals')}</a>
    </div>

    <div class="hero__wall">
      <ul class="hero__wall-list" role="list">
        {wall.map(({ journal, cover }) => (
          <li>
            <a class="hero__wall-cover" href={journal.journalUrl} target="_blank" rel="noopener noreferrer">
              <Image src={cover} alt="" width={280} height={396} widths={[140, 280]} sizes="(min-width: 1280px) 8.5rem, (min-width: 640px) 7rem, 18vw" loading="eager" />
              <span class="visually-hidden">{journal.title} ({t('common.opensNewTab')})</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="hero__wall-meta">
        <strong>{activeJournals.length}</strong>
        <span>{t('journals.active')}</span>
        <span aria-hidden="true">·</span>
        <span>{t('common.openAccess')}</span>
      </p>
    </div>
  </div>

</section>

<style>
  .hero { background: var(--surface-primary); }

  .hero__eyebrow { color: var(--text-accent); }

  .hero__intro {
    display: grid;
    justify-items: start;
    gap: 1.75rem 2rem;
    padding-block: clamp(2.25rem, 6vw, 4.75rem) clamp(2rem, 4vw, 3.5rem);
  }

  .hero__title {
    max-width: 15ch;
    margin-top: 0.9rem;
    font-size: clamp(2.6rem, 5.4vw, 4.25rem);
    font-weight: var(--fw-regular);
    line-height: 1.02;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero__search {
    display: grid;
    justify-items: start;
    gap: 0.9rem;
    width: min(100%, 27.5rem);
  }

  .hero__form {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: 100%;
    height: 3.4rem;
    padding-inline: 1rem 0.6rem;
    color: var(--text-secondary);
    background: var(--surface-raised);
    border: var(--p-border-hairline) solid var(--border-strong);
    border-radius: var(--p-radius-button);
    transition: border-color var(--p-duration-base) var(--p-ease-standard);
  }
  .hero__form:focus-within { border-color: var(--interactive-default); }
  .hero__form input {
    flex: 1;
    min-width: 0;
    height: 100%;
    color: var(--text-primary);
    font: inherit;
    font-size: 0.95rem;
    background: none;
    border: 0;
    outline: none;
  }
  .hero__form input::placeholder { color: var(--text-secondary); }
  .hero__form button {
    display: grid;
    place-items: center;
    min-width: 2rem;
    min-height: 2rem;
    color: var(--text-secondary);
    background: none;
    border: 0;
    cursor: pointer;
  }
  .hero__form button:hover { color: var(--interactive-default); }
  .hero__form button svg:dir(rtl) { transform: scaleX(-1); }
  .hero__form button:focus-visible {
    outline: var(--p-border-strong) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .hero__wall { display: grid; gap: 1rem; width: 100%; max-width: 36rem; }

  /* The five covers overlap like a fanned stack: the middle one is largest and
     on top, the outer ones tilt away from it. */
  .hero__wall-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    align-items: end;
    margin: 0;
    padding: 0.75rem 0.5rem 0;
    list-style: none;
  }
  .hero__wall-list li { position: relative; }
  .hero__wall-list li + li { margin-inline-start: -8%; }
  .hero__wall-list li:nth-child(1) { z-index: 1; transform: translateY(-1.1rem) rotate(-3deg); }
  .hero__wall-list li:nth-child(2) { z-index: 2; transform: translateY(-0.35rem) rotate(-1.2deg); }
  .hero__wall-list li:nth-child(3) { z-index: 4; transform: scale(1.14); transform-origin: bottom center; }
  .hero__wall-list li:nth-child(4) { z-index: 2; transform: translateY(-0.35rem) rotate(1.2deg); }
  .hero__wall-list li:nth-child(5) { z-index: 1; transform: translateY(-1.1rem) rotate(3deg); }
  .hero__wall-list li:hover { z-index: 5; }

  .hero__wall-cover {
    position: relative;
    display: block;
    background: var(--border-subtle);
    box-shadow: 0 2px 4px rgb(31 27 25 / 0.12), 0 24px 40px -18px rgb(31 27 25 / 0.5);
    transition: transform var(--p-duration-slow) var(--p-ease-decelerate);
  }
  .hero__wall-cover :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 495 / 700; object-fit: cover; }
  .hero__wall-cover:focus-visible {
    outline: var(--p-border-strong) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .hero__wall-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.5rem;
    margin: 1rem 0 0;
    color: var(--text-secondary);
    font-size: var(--fs-caption);
  }
  .hero__wall-meta strong {
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: var(--fw-regular);
    line-height: 1;
  }

  @media (hover: hover) {
    .hero__wall-cover:hover { transform: translateY(-0.3rem); }
  }

  @media (min-width: 1280px) {
    .hero__intro {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
    }
    .hero__wall { grid-column: 2; grid-row: 1 / span 2; justify-items: end; max-width: none; }
    .hero__wall-list { grid-template-columns: repeat(5, clamp(6rem, 8vw, 8.25rem)); padding-inline-end: 1rem; }
    .hero__wall-list li + li { margin-inline-start: -1.5rem; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__intro > div:not(.hero__wall) { animation: hero-in 700ms var(--p-ease-decelerate) both; }
    .hero__intro > .hero__search { animation-delay: 90ms; }
    .hero__wall-cover { animation: hero-in 700ms var(--p-ease-decelerate) backwards; }
    .hero__wall-list li:nth-child(2) .hero__wall-cover { animation-delay: 70ms; }
    .hero__wall-list li:nth-child(3) .hero__wall-cover { animation-delay: 140ms; }
    .hero__wall-list li:nth-child(4) .hero__wall-cover { animation-delay: 210ms; }
    .hero__wall-list li:nth-child(5) .hero__wall-cover { animation-delay: 280ms; }
  }
  @keyframes hero-in {
    from { opacity: 0; transform: translateY(0.75rem); }
    to { opacity: 1; transform: none; }
  }
</style>
