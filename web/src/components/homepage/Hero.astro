---
import { Image } from 'astro:assets';
import Button from '@/components/ui/Button.astro';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';
// Deliberately a different five from FeaturedJournals/JournalMarquee so the
// hero and the featured row never show the same covers twice.
import CSSR from '@/assets/journal-covers/CSSR.png';
import HNDH from '@/assets/journal-covers/HNDH.png';
import PFR from '@/assets/journal-covers/PFR.png';
import Silence from '@/assets/journal-covers/Silence.png';
import CPRT from '@/assets/journal-covers/CPRT.png';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);
---

<section class="hero">
  <div class="container-wide hero__row">
    <div class="hero__copy">
      <h1 class="hero__title">
        {t('home.heroTitleOne')}<br class="hero__break" />{' '}{t('home.heroTitleTwo')}
      </h1>
      <p class="hero__lede">
        {t('home.heroLede')}
      </p>
      <div class="hero__actions">
        <Button href={localizePath('/publishing/', locale)} variant="primary">
          {t('home.explorePublishing')}
        </Button>
        <Button href={localizePath('/journals/', locale)} variant="secondary">{t('common.browseJournals')}</Button>
      </div>
    </div>

    <div class="hero__visual" aria-label={t('home.heroVisual')}>
      <div class="hero__art">
        <div class="hero__books">
          <Image class="hero__book hero__book--front-left" src={CSSR} alt="Computational Social Sciences Review" width={495} height={700} widths={[240, 320, 495]} sizes="(max-width: 767px) 38vw, 20rem" loading="eager" fetchpriority="high" />
          <Image class="hero__book hero__book--front-left-mid" src={HNDH} alt="Health Nexus: Digital Health and Medical AI" width={495} height={700} widths={[240, 320, 495]} sizes="(max-width: 767px) 38vw, 20rem" loading="eager" fetchpriority="high" />
          <Image class="hero__book hero__book--front-center" src={PFR} alt="Panorama Frontier Review" width={495} height={700} widths={[240, 320, 495]} sizes="(max-width: 767px) 38vw, 20rem" loading="eager" fetchpriority="high" />
          <Image class="hero__book hero__book--front-right-mid" src={Silence} alt="Silence" width={495} height={700} widths={[240, 320, 495]} sizes="(max-width: 767px) 38vw, 20rem" loading="eager" fetchpriority="high" />
          <Image class="hero__book hero__book--front-right" src={CPRT} alt="Comparative Philosophy &amp; Religious Traditions" width={495} height={700} widths={[240, 320, 495]} sizes="(max-width: 767px) 38vw, 20rem" loading="eager" fetchpriority="high" />
        </div>
        <span class="hero__shelf-line" aria-hidden="true"></span>
      </div>
    </div>
  </div>

</section>

<style>
  .hero {
    background: var(--surface-primary);
    padding-block: 2.35rem 1.45rem;
  }

  .hero__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.35rem;
    align-items: center;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
  }


  .hero__title {
    max-width: none;
    margin-top: 1.1rem;
    font-size: clamp(3rem, 5.4vw, 4.2rem);
    font-weight: var(--fw-regular);
    line-height: 1.04;
    letter-spacing: -0.025em;
  }

  .hero__lede {
    max-width: 32rem;
    margin-top: 1.15rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 1.08rem;
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1.35rem;
  }

  .hero__visual {
    min-width: 0;
  }

  .hero__art {
    position: relative;
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    aspect-ratio: 1.6 / 1;
  }


  .hero__book {
    position: absolute;
    display: block;
    width: auto;
    height: auto;
    object-fit: cover;
    box-shadow: 0 0.15rem 0.25rem color-mix(in srgb, var(--brand-primary) 8%, transparent);
  }

  .hero__books {
    position: absolute;
    inset: 0;
    transform: translateX(4.5%);
    z-index: 3;
  }

  /* Five volumes share one shelf line, with gentle overlap for a book-like
     rhythm. The centre volume is the tallest; the outer pair sit lowest in
     the stack order so the fan reads from the middle outwards. */
  .hero__book--front-left {
    bottom: 14%;
    left: 0;
    width: 21%;
    z-index: 4;
  }

  .hero__book--front-left-mid {
    bottom: 14%;
    left: 16.5%;
    width: 22%;
    z-index: 5;
  }

  .hero__book--front-center {
    bottom: 14%;
    left: 34%;
    width: 24.5%;
    z-index: 8;
  }

  .hero__book--front-right-mid {
    bottom: 14%;
    left: 53.5%;
    width: 21.5%;
    z-index: 6;
  }

  .hero__book--front-right {
    bottom: 14%;
    left: 70.5%;
    width: 22%;
    z-index: 4;
  }

  /* Entry: the volumes rise onto the shelf one after another, centre first.
     Communicates "a collection", not decoration, and runs once. */
  @media (prefers-reduced-motion: no-preference) {
    .hero__book {
      animation: hero-book-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero__book--front-center { animation-delay: 80ms; }
    .hero__book--front-left-mid,
    .hero__book--front-right-mid { animation-delay: 200ms; }
    .hero__book--front-left,
    .hero__book--front-right { animation-delay: 320ms; }

    .hero__copy > * {
      animation: hero-copy-in 700ms cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    .hero__copy > :nth-child(2) { animation-delay: 90ms; }
    .hero__copy > :nth-child(3) { animation-delay: 180ms; }
  }

  @keyframes hero-book-rise {
    from { opacity: 0; transform: translateY(1.5rem); }
    to { opacity: 1; transform: none; }
  }

  @keyframes hero-copy-in {
    from { opacity: 0; transform: translateY(0.75rem); }
    to { opacity: 1; transform: none; }
  }

  /* The shelf's top edge sits exactly on the books' bottom edge (14%), and
     it is drawn behind the covers, so the volumes stand on it rather than
     appearing to sink through it. */
  .hero__shelf-line {
    position: absolute;
    right: 0;
    bottom: calc(14% - 0.45rem);
    left: 0;
    height: 0.45rem;
    background: linear-gradient(var(--border-strong), var(--border-strong)) top / 100% 0.12rem no-repeat,
      linear-gradient(color-mix(in srgb, var(--border-strong) 22%, transparent), transparent) bottom / 100% 0.35rem no-repeat;
    z-index: 2;
  }



  @media (min-width: 768px) {
    .hero {
      padding-top: 0;
      padding-bottom: 0;
    }

    .hero__row {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: stretch;
    }

    .hero__copy {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding-top: 2.15rem;
      padding-bottom: 12%;
    }

    .hero__actions { margin-top: 3.5rem; }

    /* The fan sits on the same baseline as the CTAs, below the
       (nowrap, wide) headline, so the two never collide. */
    .hero__visual {
      display: flex;
      align-items: flex-end;
      padding-top: 7rem;
    }


    .hero__art {
      max-width: none;
      aspect-ratio: 1.55 / 1;
      width: calc(100% + 5rem);
      margin-inline-start: -1.5rem;
      margin-inline-end: 0;
    }

    .hero__title {
      white-space: nowrap;
      font-size: clamp(3.8rem, 5.2vw, 5.1rem);
    }

    .hero__lede {
      max-width: 34rem;
      font-size: 1.15rem;
    }
  }

  @media (max-width: 767px) {
    .hero__row { gap: 1.25rem; }
    .hero__art { aspect-ratio: 1.9 / 1; }
    .hero__break { display: none; }
    .hero__title { max-width: 18ch; }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .hero__books { transform: translateX(0); }
  }

  @media (min-width: 1200px) {
    .hero__title {
      font-size: clamp(4rem, 5.4vw, 5.4rem);
    }

    .hero__lede {
      max-width: 35rem;
      font-size: 1.18rem;
    }

    .hero__actions { margin-top: 5rem; }
  }
</style>
