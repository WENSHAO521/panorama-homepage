---
import PhraseText from '@/components/ui/PhraseText.astro';
import ImprintCard from '@/components/imprint/ImprintCard.astro';
import imprintsData from '@/data/imprints.json';
import type { Imprint } from '@/types';
import { getLocalizedImprints } from '@/i18n/catalog';
import { getJournalsForImprint } from '@/lib/content/imprints';
import { getJournalCoverAsset } from '@/lib/assets/journalCovers';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const imprints = getLocalizedImprints(imprintsData as Imprint[], locale).map((imprint) => {
  const journals = getJournalsForImprint(imprint.slug, locale);
  // Up to three covers per card, fanned at the foot of the tile.
  const covers = journals.flatMap((j) => { const c = getJournalCoverAsset(j.cover); return c ? [c] : []; }).slice(0, 3);
  return { imprint, count: journals.length, covers };
});
---

<!-- One tinted card per imprint: wordmark, scope, and a fan of its covers.
     Deliberately
     not a .row, so the group-wide section padding (up to 7rem each side)
     doesn't turn a single line of logos into a tall empty band. -->
<section class="imprint-section" aria-labelledby="imprint-section-title">
  <div class="container-wide">
    <div class="imprint-section__inner">
      <div class="imprint-section__header">
        <h2 id="imprint-section-title" class="imprint-section__title"><PhraseText text={t('home.imprintsTitle')} /></h2>
        <a href={localizePath('/imprints/', locale)} class="imprint-section__link">{t('common.viewAllImprints')}</a>
      </div>

      <ul class="imprint-grid" role="list">
        {imprints.map(({ imprint, count, covers }) => (
          <ImprintCard imprint={imprint} locale={locale} count={count} countLabel={t('common.journals')} covers={covers} />
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .imprint-section {
    background: var(--surface-primary);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .imprint-section__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .imprint-section__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .imprint-section__link {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.3em;
    white-space: nowrap;
  }
  .imprint-section__link:hover { color: var(--interactive-default); text-decoration-color: currentColor; }

  .imprint-grid {
    display: grid;
    gap: 1rem;
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .imprint-grid { grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .imprint-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .imprint-grid { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
</style>
