---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import ImprintCard from '@/components/imprint/ImprintCard.astro';
import imprintsData from '@/data/imprints.json';
import type { Imprint } from '@/types';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const imprints = imprintsData as Imprint[];
---

<!-- row--tight: this section is a heading plus one line of logos, so the
     group-wide section rhythm (up to 7rem each side, group-system.css)
     leaves it looking empty. The tight variant is the system's own step. -->
<section class="row row--tight imprint-section">
  <div class="container-wide">
    <div class="imprint-section__header">
      <SectionHeading
        title={t('home.imprintsTitle')}
        lede={t('home.imprintsLede')}
      />
      <a href={localizePath('/imprints/', locale)} class="imprint-section__link">{t('common.viewAllImprints')}</a>
    </div>
    <ul class="imprint-grid" role="list">
      {imprints.map((imprint) => (
        <ImprintCard imprint={imprint} locale={locale} />
      ))}
    </ul>
  </div>
</section>

<style>
  .imprint-section {
    background: var(--surface-primary);
  }

  .imprint-section :global(.section-heading__title) {
    font-size: clamp(1.55rem, 3vw, 2rem);
    font-weight: var(--fw-regular);
    line-height: 1.15;
  }

  .imprint-section :global(.section-heading__lede) {
    margin-top: 0.3rem;
    font-family: var(--font-display);
    max-width: none;
    font-size: 0.72rem;
    line-height: 1.35;
  }

  .imprint-section__header {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .imprint-section__header {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  .imprint-section__link {
    margin-top: 0.35rem;
    color: var(--text-primary);
    font-size: 0.72rem;
    font-weight: var(--fw-semibold);
    text-decoration: none;
    white-space: nowrap;
  }

  .imprint-section__link:hover { color: var(--interactive-default); }

  .imprint-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 1rem;
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
  }

  @media (min-width: 640px) and (max-width: 767px) {
    .imprint-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .imprint-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
</style>
