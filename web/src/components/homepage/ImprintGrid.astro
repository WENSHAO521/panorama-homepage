---
import ImprintCard from '@/components/imprint/ImprintCard.astro';
import imprintsData from '@/data/imprints.json';
import type { Imprint } from '@/types';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const imprints = imprintsData as Imprint[];
---

<!-- A brand strip in the manner of a publisher's "Our brands" row: hairline,
     small label, one line of logos at a shared optical height. Deliberately
     not a .row, so the group-wide section padding (up to 7rem each side)
     doesn't turn a single line of logos into a tall empty band. -->
<section class="imprint-section" aria-labelledby="imprint-section-title">
  <div class="container-wide">
    <div class="imprint-section__inner">
      <div class="imprint-section__header">
        <h2 id="imprint-section-title" class="imprint-section__title">{t('home.imprintsTitle')}</h2>
        <a href={localizePath('/imprints/', locale)} class="imprint-section__link">{t('common.viewAllImprints')}</a>
      </div>

      <ul class="imprint-grid" role="list">
        {imprints.map((imprint) => (
          <ImprintCard imprint={imprint} locale={locale} />
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .imprint-section {
    background: var(--surface-primary);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  .imprint-section__inner {
    padding-top: 1.25rem;
    border-top: var(--p-border-hairline) solid var(--border-strong);
  }

  .imprint-section__header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
  }

  .imprint-section__title {
    margin: 0;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0;
    line-height: 1.3;
  }

  .imprint-section__link {
    color: var(--text-secondary);
    font-size: 0.875rem;
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 0.3em;
    white-space: nowrap;
  }
  .imprint-section__link:hover { color: var(--interactive-default); text-decoration-color: currentColor; }

  /* Logos run edge to edge: first flush with the start of the rule, last
     flush with the end, even gaps between. */
  .imprint-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  @media (min-width: 640px) and (max-width: 1199px) {
    .imprint-grid { column-gap: 1.25rem; }
  }

  /* Phones: two per row, start-aligned, so wrapping never centres a lone logo. */
  @media (max-width: 639px) {
    .imprint-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.25rem 1.5rem;
    }
  }
</style>
