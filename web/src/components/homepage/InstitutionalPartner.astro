---
import { Image } from 'astro:assets';
import taoistAssociationLogo from '@/assets/partners/taoist-association-korea-logo.png';
import cashlLogo from '@/assets/index-logos/library-logo.png';
import cjwkLogo from '@/assets/index-logos/CJWK.png';
import atriLogo from '@/assets/partners/asia-technology-research-institute-logo.png';
import shiharrLogo from '@/assets/partners/shiharr-publishing-logo.png';
import jandlLogo from '@/assets/partners/jandl-academic-group-logo.png';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const partnerLogos = [
  {
    name: 'Taoist Association of Korea',
    logo: taoistAssociationLogo,
  },
  {
    name: 'China Academic Social Sciences and Humanities Library',
    logo: cashlLogo,
    href: 'https://www.cashl.edu.cn/',
  },
  {
    name: 'Changjiang Wenku',
    logo: cjwkLogo,
    href: 'https://www.cjwk.cn',
  },
  {
    name: 'Asia Technology Research Institute (ATRI)',
    logo: atriLogo,
    href: 'https://atripress.org/',
  },
  {
    name: 'Shiharr Publishing',
    logo: shiharrLogo,
    href: 'https://www.shiharr.cn/',
  },
  {
    name: 'J&L Academic Group',
    logo: jandlLogo,
    href: 'https://www.jandlpress.com/',
  },
];
---

<section class="institutional-partner" aria-labelledby="institutional-partner-title">
  <div class="container-wide institutional-partner__inner">
    <div class="institutional-partner__intro">
      <p class="text-overline">{t('common.institutionalPartnership')}</p>
      <h2 id="institutional-partner-title">{t('common.inPartnershipWith')}</h2>
    </div>

    <div class="institutional-partner__marquee" aria-label="Partner logos">
      <div class="institutional-partner__viewport">
        <div class="institutional-partner__track">
          <div class="institutional-partner__group">
            {partnerLogos.map((partner) => partner.href ? (
              <a
                class="institutional-partner__logo"
                href={partner.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={partner.name}
              >
                <Image
                  src={partner.logo}
                  alt={partner.name}
                  widths={[96, 160, 240]}
                  sizes="(max-width: 639px) 8rem, 9rem"
                  loading="lazy"
                />
              </a>
            ) : (
              <div class="institutional-partner__logo">
                <Image
                  src={partner.logo}
                  alt={partner.name}
                  widths={[96, 160, 240]}
                  sizes="(max-width: 639px) 8rem, 9rem"
                  loading="lazy"
                />
              </div>
            ))}
          </div>

          <div class="institutional-partner__group institutional-partner__group--duplicate" aria-hidden="true">
            {partnerLogos.map((partner) => (
              <div class="institutional-partner__logo">
                <Image
                  src={partner.logo}
                  alt=""
                  widths={[96, 160, 240]}
                  sizes="(max-width: 639px) 8rem, 9rem"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <a class="institutional-partner__link" href={localizePath('/about/partnerships/', locale)}>{t('common.aboutPartnerships')}</a>
  </div>
</section>

<style>
  .institutional-partner {
    background: var(--surface-secondary);
    border-block: var(--p-border-hairline) solid var(--border-subtle);
  }

  .institutional-partner__inner {
    display: grid;
    grid-template-columns: minmax(10rem, 0.72fr) minmax(0, 2.6fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    min-height: 8.25rem;
  }

  .institutional-partner__intro h2 {
    margin: 0.4rem 0 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .institutional-partner__marquee {
    min-width: 0;
    overflow: hidden;
  }

  .institutional-partner__viewport {
    overflow: visible;
  }

  .institutional-partner__track {
    width: 100%;
  }

  .institutional-partner__group {
    display: grid;
    grid-template-columns: repeat(3, minmax(7rem, 1fr));
    align-items: center;
    gap: 0.75rem 1.2rem;
    width: 100%;
  }

  .institutional-partner__group--duplicate {
    display: none;
  }

  .institutional-partner__logo {
    display: flex;
    width: 100%;
    height: 5.25rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem;
    color: inherit;
    text-decoration: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  a.institutional-partner__logo:hover,
  a.institutional-partner__logo:focus-visible {
    opacity: 0.72;
    transform: translateY(-1px);
  }

  .institutional-partner__logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .institutional-partner__link {
    justify-self: end;
    border-bottom: var(--p-border-hairline) solid var(--brand-accent);
    color: var(--text-primary);
    font-size: 0.68rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.08em;
    line-height: 1.8;
    text-decoration: none;
    text-transform: uppercase;
  }

  .institutional-partner__link:hover,
  .institutional-partner__link:focus-visible {
    color: var(--interactive-default);
  }

  @media (max-width: 767px) {
    .institutional-partner__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem 1.25rem;
      min-height: 7rem;
    }

    .institutional-partner__marquee { grid-column: 1 / -1; }

    .institutional-partner__link {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 639px) {
    .institutional-partner__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
      padding-block: 1.35rem;
    }

    .institutional-partner__marquee { width: 100%; }
    .institutional-partner__group { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .institutional-partner__logo { height: 4.75rem; }
  }
</style>
