---
import PhraseText from '@/components/ui/PhraseText.astro';
import { Image } from 'astro:assets';
import taoistAssociationLogo from '@/assets/partners/taoist-association-korea-logo.png';
import cashlLogo from '@/assets/index-logos/library-logo.png';
import cjwkLogo from '@/assets/index-logos/CJWK.png';
import atriLogo from '@/assets/partners/asia-technology-research-institute-logo.png';
import shiharrLogo from '@/assets/partners/shiharr-publishing-logo.png';
import jandlLogo from '@/assets/partners/jandl-academic-group-logo.png';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const partnerLogos = [
  {
    name: 'Taoist Association of Korea',
    logo: taoistAssociationLogo,
  },
  {
    name: 'China Academic Social Sciences and Humanities Library',
    logo: cashlLogo,
    wide: true,
    href: 'https://www.cashl.edu.cn/',
  },
  {
    name: 'Changjiang Wenku',
    logo: cjwkLogo,
    inverse: true,
    href: 'https://www.cjwk.cn',
  },
  {
    name: 'Asia Technology Research Institute (ATRI)',
    logo: atriLogo,
    href: 'https://atripress.org/',
  },
  {
    name: 'Shiharr Publishing',
    logo: shiharrLogo,
    inverse: true,
    href: 'https://www.shiharr.cn/',
  },
  {
    name: 'J&L Academic Group',
    logo: jandlLogo,
    href: 'https://www.jandlpress.com/',
  },
];
---

<section class="institutional-partner" aria-labelledby="institutional-partner-title">
  <div class="container-wide institutional-partner__inner">
    <div class="institutional-partner__intro">
      <h2 id="institutional-partner-title"><PhraseText text={t('common.inPartnershipWith')} /></h2>
    </div>

    <div class="institutional-partner__marquee" aria-label="Partner logos">
      <div class="institutional-partner__viewport">
        <div class="institutional-partner__track">
          <div class="institutional-partner__group">
            {partnerLogos.map((partner) => partner.href ? (
              <a
                class:list={["institutional-partner__logo", { "institutional-partner__logo--inverse": partner.inverse, "institutional-partner__logo--wide": partner.wide }]}
                href={partner.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={partner.name}
              >
                <Image
                  src={partner.logo}
                  alt={partner.name}
                  widths={[96, 160, 240]}
                  sizes="(max-width: 639px) 8rem, 9rem"
                  loading="lazy"
                />
              </a>
            ) : (
              <div class:list={["institutional-partner__logo", { "institutional-partner__logo--inverse": partner.inverse, "institutional-partner__logo--wide": partner.wide }]}>
                <Image
                  src={partner.logo}
                  alt={partner.name}
                  widths={[96, 160, 240]}
                  sizes="(max-width: 639px) 8rem, 9rem"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <a class="institutional-partner__link" href={localizePath('/about/partnerships/', locale)}>{t('common.aboutPartnerships')}</a>
  </div>
</section>

<style>
  /* Ink band that runs straight into the ink footer below. */
  .institutional-partner {
    --focus-ring: var(--text-inverse);
    background: var(--surface-inverse);
    color: var(--text-inverse);
  }

  .institutional-partner__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(2rem, 4vw, 3rem);
  }

  /* Title and link share the top line; the partners sit on their own row. */
  .institutional-partner__intro { grid-column: 1; grid-row: 1; }
  .institutional-partner__link { grid-column: 2; grid-row: 1; }

  .institutional-partner__intro h2 {
    margin: 0.5rem 0 0;
    color: var(--text-inverse);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  @media (min-width: 768px) {
    .institutional-partner__intro h2 { white-space: nowrap; }
  }

  .institutional-partner__marquee {
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
    padding-top: 1.5rem;
    border-top: var(--p-border-hairline) solid var(--border-inverse);
  }

  .institutional-partner__track {
    display: flex;
    align-items: center;
  }

  .institutional-partner__group {
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }


  .institutional-partner__logo {
    display: flex;
    flex: 0 0 10rem;
    width: 10rem;
    height: 5.25rem;
    align-items: center;
    justify-content: center;
    padding: 0.75rem;
    color: inherit;
    text-decoration: none;
    transition: opacity var(--p-duration-fast) var(--p-ease-standard);
  }

  /* Wordmark-only logos (long and thin) get a wider slot so they are not
     scaled down to an unreadable height. */
  .institutional-partner__logo--wide { flex-basis: 14rem; width: 14rem; }




  /* Source logos differ in colour and contrast. On the ink band the marks
     drawn for paper are flattened to a light silhouette; the two drawn for
     dark backgrounds (--inverse) are only desaturated and return to full
     colour on hover/focus. */
  .institutional-partner__logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.72;
    transition: filter var(--p-duration-base) var(--p-ease-standard), opacity var(--p-duration-base) var(--p-ease-standard);
  }

  .institutional-partner__logo--inverse img { filter: grayscale(1); opacity: 0.82; }

  a.institutional-partner__logo:hover img,
  a.institutional-partner__logo:focus-visible img {
    opacity: 1;
  }
  a.institutional-partner__logo--inverse:hover img,
  a.institutional-partner__logo--inverse:focus-visible img {
    filter: none;
  }

  .institutional-partner__link {
    justify-self: end;
    border-bottom: var(--p-border-hairline) solid var(--brand-accent);
    color: var(--text-inverse);
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    line-height: 1.8;
    text-decoration: none;
    white-space: nowrap;
  }

  .institutional-partner__link:hover,
  .institutional-partner__link:focus-visible {
    color: var(--text-accent-inverse);
  }


  @media (max-width: 767px) {
    .institutional-partner__group { justify-content: flex-start; }
  }

  @media (max-width: 639px) {
    .institutional-partner__inner { grid-template-columns: 1fr; gap: 1rem; }
    .institutional-partner__link { grid-column: 1; grid-row: 3; justify-self: start; }
    .institutional-partner__group { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem 1rem; }
    .institutional-partner__logo,
    .institutional-partner__logo--wide { width: 100%; height: 4.5rem; }
  }
</style>
