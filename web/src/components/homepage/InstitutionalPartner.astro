---
import { Image } from 'astro:assets';
import taoistAssociationLogo from '@/assets/partners/taoist-association-korea-logo.png';
import cashlLogo from '@/assets/index-logos/library-logo.png';
import cjwkLogo from '@/assets/index-logos/CJWK.png';
import atriLogo from '@/assets/partners/asia-technology-research-institute-logo.png';
import shiharrLogo from '@/assets/partners/shiharr-publishing-logo.png';
import jandlLogo from '@/assets/partners/jandl-academic-group-logo.png';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const partnerLogos = [
  {
    name: 'Taoist Association of Korea',
    logo: taoistAssociationLogo,
  },
  {
    name: 'China Academic Social Sciences and Humanities Library',
    logo: cashlLogo,
    href: 'https://www.cashl.edu.cn/',
  },
  {
    name: 'Changjiang Wenku',
    logo: cjwkLogo,
    href: 'https://www.cjwk.cn',
  },
  {
    name: 'Asia Technology Research Institute (ATRI)',
    logo: atriLogo,
    href: 'https://atripress.org/',
  },
  {
    name: 'Shiharr Publishing',
    logo: shiharrLogo,
    href: 'https://www.shiharr.cn/',
  },
  {
    name: 'J&L Academic Group',
    logo: jandlLogo,
    href: 'https://www.jandlpress.com/',
  },
];
---

<section class="institutional-partner" aria-labelledby="institutional-partner-title">
  <div class="container-wide institutional-partner__inner">
    <div class="institutional-partner__intro">
      <h2 id="institutional-partner-title">{t('common.inPartnershipWith')}</h2>
    </div>

    <div class="institutional-partner__marquee" aria-label="Partner logos">
      <div class="institutional-partner__viewport">
        <div class="institutional-partner__track">
          <div class="institutional-partner__group">
            {partnerLogos.map((partner) => partner.href ? (
              <a
                class="institutional-partner__logo"
                href={partner.href}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={partner.name}
              >
                <Image
                  src={partner.logo}
                  alt={partner.name}
                  widths={[96, 160, 240]}
                  sizes="(max-width: 639px) 8rem, 9rem"
                  loading="lazy"
                />
              </a>
            ) : (
              <div class="institutional-partner__logo">
                <Image
                  src={partner.logo}
                  alt={partner.name}
                  widths={[96, 160, 240]}
                  sizes="(max-width: 639px) 8rem, 9rem"
                  loading="lazy"
                />
              </div>
            ))}
          </div>

          <div class="institutional-partner__group institutional-partner__group--duplicate" aria-hidden="true">
            {partnerLogos.map((partner) => (
              <div class="institutional-partner__logo">
                <Image
                  src={partner.logo}
                  alt=""
                  widths={[96, 160, 240]}
                  sizes="(max-width: 639px) 8rem, 9rem"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <a class="institutional-partner__link" href={localizePath('/about/partnerships/', locale)}>{t('common.aboutPartnerships')}</a>
  </div>
</section>

<style>
  .institutional-partner {
    background: var(--surface-secondary);
    border-block: var(--p-border-hairline) solid var(--border-subtle);
  }

  .institutional-partner__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 4rem);
    min-height: 9rem;
  }

  .institutional-partner__intro h2 {
    margin: 0.4rem 0 0;
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  @media (min-width: 768px) {
    .institutional-partner__intro h2 { white-space: nowrap; }
  }

  .institutional-partner__marquee {
    min-width: 0;
    overflow: hidden;
  }

  .institutional-partner__viewport {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 4%, black 96%, transparent);
  }

  .institutional-partner__track {
    display: flex;
    width: max-content;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0;
    animation: institutional-partner-marquee 18s linear infinite;
    animation-delay: -3s;
    will-change: transform;
  }

  .institutional-partner__group {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    flex-wrap: nowrap;
    gap: 1.2rem;
  }

  .institutional-partner__logo {
    display: flex;
    flex: 0 0 10rem;
    width: 10rem;
    height: 5.25rem;
    align-items: center;
    justify-content: center;
    padding: 0.7rem;
    color: inherit;
    text-decoration: none;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  a.institutional-partner__logo:hover,
  a.institutional-partner__logo:focus-visible {
    transform: translateY(-1px);
  }

  .institutional-partner__marquee:hover .institutional-partner__track,
  .institutional-partner__marquee:focus-within .institutional-partner__track {
    animation-play-state: paused;
  }

  /* Source logos differ in colour and contrast (one is pale grey). A shared
     monochrome treatment makes them read as one row; linked logos return
     to full colour on hover/focus. */
  .institutional-partner__logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1) contrast(1.15);
    opacity: 0.8;
    transition: filter var(--p-duration-base) var(--p-ease-standard), opacity var(--p-duration-base) var(--p-ease-standard);
  }

  a.institutional-partner__logo:hover img,
  a.institutional-partner__logo:focus-visible img {
    filter: none;
    opacity: 1;
  }

  .institutional-partner__link {
    justify-self: end;
    border-bottom: var(--p-border-hairline) solid var(--brand-accent);
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    line-height: 1.8;
    text-decoration: none;
    white-space: nowrap;
  }

  .institutional-partner__link:hover,
  .institutional-partner__link:focus-visible {
    color: var(--interactive-default);
  }

  @keyframes institutional-partner-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .institutional-partner__viewport {
      overflow-x: auto;
      mask-image: none;
      -webkit-mask-image: none;
      scrollbar-width: none;
    }

    .institutional-partner__viewport::-webkit-scrollbar { display: none; }

    .institutional-partner__track {
      width: max-content;
      flex-wrap: nowrap;
      animation: none;
    }

    .institutional-partner__group {
      width: auto;
      flex-wrap: nowrap;
    }

    .institutional-partner__group--duplicate { display: none; }
  }

  @media (max-width: 767px) {
    .institutional-partner__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem 1.25rem;
      min-height: 7rem;
    }

    .institutional-partner__marquee { grid-column: 1 / -1; }

    .institutional-partner__link {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 639px) {
    .institutional-partner__inner {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1rem;
      padding-block: 1.35rem;
    }

    .institutional-partner__marquee { width: 100%; }
    .institutional-partner__logo { flex-basis: 8rem; width: 8rem; height: 4.75rem; }
  }
</style>
