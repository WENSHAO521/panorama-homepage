---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getAnnouncements } from '@/data/announcements';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const announcements = getAnnouncements(locale)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

function formatDate(value: string) {
  return new Intl.DateTimeFormat(locale, {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
    timeZone: 'UTC',
  }).format(new Date(value + 'T00:00:00Z'));
}

function announcementHref(value: string) {
  return value.startsWith('/') ? localizePath(value, locale) : value;
}

function isExternal(value: string) {
  return /^https?:\/\//i.test(value);
}
---

<section class="row latest-announcements">
  <!-- Heading column + list column, so the list fills the width instead of
       leaving the left third empty. The right column carries real content,
       not a floating explainer. -->
  <div class="container-wide latest-announcements__grid">
    <div class="latest-announcements__header">
      <SectionHeading
        title={t('home.latestAnnouncements')}
        lede={t('home.latestAnnouncementsLede')}
      />
      <a href={localizePath('/news/', locale)} class="latest-announcements__link">{t('common.viewAllAnnouncements')}</a>
    </div>

    <ol class="latest-announcements__list" role="list">
      {announcements.map((announcement) => (
        <li>
          <a
            href={announcementHref(announcement.href)}
            class="latest-announcements__item"
            target={isExternal(announcement.href) ? '_blank' : undefined}
            rel={isExternal(announcement.href) ? 'noopener noreferrer' : undefined}
            aria-label={announcement.title}
          >
            <time datetime={announcement.date}>{formatDate(announcement.date)}</time>
            <span class="latest-announcements__content">
              <span class="latest-announcements__meta">
                <span>{announcement.sourceLabel}</span>
                <span>{announcement.type}</span>
              </span>
              <span class="latest-announcements__title">{announcement.title}</span>
              <span class="latest-announcements__summary">{announcement.summary}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .latest-announcements {
    background: var(--surface-primary);
    border-top: var(--p-border-hairline) solid var(--border-subtle);
    padding-block: 3.5rem 4rem;
  }

  .latest-announcements__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .latest-announcements :global(.section-heading__title) {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: var(--fw-regular);
    line-height: 1.12;
  }

  .latest-announcements :global(.section-heading__lede) {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.45;
  }

  .latest-announcements__link {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    text-decoration: underline;
    text-decoration-color: var(--brand-accent);
    text-underline-offset: 0.35em;
    white-space: nowrap;
  }

  .latest-announcements__link:hover,
  .latest-announcements__link:focus-visible {
    color: var(--interactive-default);
  }

  .latest-announcements__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .latest-announcements__list li + li {
    border-top: var(--p-border-hairline) solid var(--border-subtle);
  }

  .latest-announcements__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
    padding-block: 1.25rem;
    color: inherit;
    text-decoration: none;
  }

  .latest-announcements__list li:first-child .latest-announcements__item { padding-top: 0; }

  .latest-announcements__item:hover .latest-announcements__title,
  .latest-announcements__item:focus-visible .latest-announcements__title {
    color: var(--interactive-default);
  }

  .latest-announcements__item time {
    color: var(--text-primary);
    font-size: 0.875rem;
    font-weight: var(--fw-semibold);
    white-space: nowrap;
  }

  .latest-announcements__content {
    display: block;
    min-width: 0;
  }

  .latest-announcements__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .latest-announcements__meta span + span {
    color: var(--text-accent);
  }

  .latest-announcements__title {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.2;
    transition: color var(--p-duration-fast) var(--p-ease-standard);
  }

  .latest-announcements__summary {
    display: block;
    max-width: 68ch;
    margin-top: 0.45rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (min-width: 900px) {
    .latest-announcements__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 4rem;
    }

    .latest-announcements__item {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 1.5rem;
    }

    .latest-announcements__item time { padding-top: 0.05rem; }
  }
</style>
