---
import PhraseText from '@/components/ui/PhraseText.astro';
import SectionHead from './SectionHead.astro';
import { getAnnouncements } from '@/data/announcements';
import { getContent } from '@/i18n/content';
import { getNewsCopy } from '@/i18n/utility';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);
const newsCopy = getNewsCopy(locale);

const announcements = getAnnouncements(locale)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 3);

function formatDate(value: string) {
  return new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' })
    .format(new Date(value + 'T00:00:00Z'));
}
function announcementHref(value: string) {
  return value.startsWith('/') ? localizePath(value, locale) : value;
}
function isExternal(value: string) {
  return /^https?:\/\//i.test(value);
}
---

<section class="row home-announcements" aria-labelledby="home-announcements-title">
  <div class="container-wide">
    <SectionHead
      id="home-announcements-title"
      title={t('home.latestAnnouncements')}
      lede={t('home.latestAnnouncementsLede')}
      href={localizePath('/news/', locale)}
      linkLabel={t('common.viewAllAnnouncements')}
      locale={locale}
    />

    <!-- Three across, hairline-separated: the same shelf rhythm as the featured journals. -->
    <ol class="home-announcements__list" role="list">
      {announcements.map((announcement) => (
        <li>
          <a
            href={announcementHref(announcement.href)}
            class="home-announcements__item"
            target={isExternal(announcement.href) ? '_blank' : undefined}
            rel={isExternal(announcement.href) ? 'noopener noreferrer' : undefined}
            aria-label={announcement.title}
          >
            <p class="home-announcements__meta">
              <time datetime={announcement.date}>{formatDate(announcement.date)}</time>
              <span>{newsCopy.typeLabels[announcement.type.toLowerCase() as keyof typeof newsCopy.typeLabels] ?? announcement.type}</span>
            </p>
            <p class="home-announcements__source">{announcement.sourceLabel}</p>
            <h3 class="home-announcements__title"><PhraseText text={announcement.title} /></h3>
            <p class="home-announcements__summary">{announcement.summary}</p>
            <span class="home-announcements__cta">{t('home.readAnnouncement')}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .home-announcements {
    background: var(--surface-primary);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .home-announcements__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-announcements__list li { padding-block: 1.5rem; border-top: var(--p-border-hairline) solid var(--border-subtle); }
  .home-announcements__list li:first-child { padding-top: 0; border-top: 0; }
  .home-announcements__list li:last-child { padding-bottom: 0; }

  .home-announcements__item {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    height: 100%;
    color: inherit;
    text-decoration: none;
  }
  .home-announcements__item:focus-visible {
    outline: var(--p-border-strong) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .home-announcements__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .home-announcements__meta span { color: var(--text-accent); }

  .home-announcements__source {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-caption);
  }

  .home-announcements__title {
    margin: 0;
    font-size: 1.3rem;
    font-weight: var(--fw-regular);
    letter-spacing: -0.01em;
    line-height: 1.2;
    text-wrap: balance;
  }
  .home-announcements__item:hover .home-announcements__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .home-announcements__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .home-announcements__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    width: fit-content;
    min-height: var(--p-link-min-height);
    margin-top: auto;
    padding-top: 0.3rem;
    color: var(--text-link);
    font-size: var(--p-link-font-size);
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: var(--p-action-underline-offset);
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  }
  .home-announcements__cta::after {
    content: '';
    width: 0.85em;
    height: 0.62em;
    background: currentColor;
    -webkit-mask: var(--p-action-arrow) center / contain no-repeat;
    mask: var(--p-action-arrow) center / contain no-repeat;
    transition: transform var(--p-duration-base) var(--p-ease-standard);
  }
  .home-announcements__item:hover .home-announcements__cta { text-decoration-color: currentColor; }
  .home-announcements__item:hover .home-announcements__cta::after { transform: translateX(var(--p-action-nudge)); }

  @media (min-width: 900px) {
    .home-announcements__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .home-announcements__list li { padding: 0 2rem; border-top: 0; border-inline-start: var(--p-border-hairline) solid var(--border-subtle); }
    .home-announcements__list li:first-child { padding-inline-start: 0; border-inline-start: 0; }
    .home-announcements__list li:last-child { padding-inline-end: 0; }
  }
</style>
