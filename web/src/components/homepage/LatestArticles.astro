---
import PhraseText from '@/components/ui/PhraseText.astro';
import SectionHead from './SectionHead.astro';
import articleData from '@/data/articles.json';
import { isRetractedArticle } from '@/lib/articleFilter.mjs';
import { getContent } from '@/i18n/content';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const [lead, ...rest] = [...articleData.articles]
  .filter((article) => !isRetractedArticle(article))
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))
  .slice(0, 3);

function formatDate(value: string) {
  return new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'short', day: '2-digit', timeZone: 'UTC' })
    .format(new Date(value + 'T00:00:00Z'));
}

// Long consortium author lists crowd out the title; show the first three.
function formatAuthors(authors: string[]) {
  return authors.length > 3 ? `${authors.slice(0, 3).join(', ')} et al.` : authors.join(', ');
}
---

<section class="row home-articles" aria-labelledby="home-articles-title">
  <div class="container-wide">
    <SectionHead id="home-articles-title" title={t('home.selectedArticles')} lede={t('home.selectedArticlesLede')} locale={locale} />

    {lead && (
      <div class="home-articles__grid">
        <!-- Lead + two: the newest article gets room for its summary; the next
             two stay compact, so three identical text cards never sit side by side. -->
        <article class="home-articles__lead">
          <a href={lead.url} class="home-articles__link" target="_blank" rel="noopener noreferrer" aria-label={lead.title + ' (opens in a new tab)'}>
            <p class="home-articles__meta"><span>{lead.journal}</span><time datetime={lead.publishedAt}>{formatDate(lead.publishedAt)}</time></p>
            <h3 class="home-articles__lead-title"><PhraseText text={lead.title} /></h3>
            <p class="home-articles__summary">{lead.summary}</p>
            <p class="home-articles__authors">{formatAuthors(lead.authors)}</p>
            <span class="home-articles__cta">{t('home.readArticle')}</span>
          </a>
        </article>

        <ul class="home-articles__list" role="list">
          {rest.map((article) => (
            <li>
              <a href={article.url} class="home-articles__link" target="_blank" rel="noopener noreferrer" aria-label={article.title + ' (opens in a new tab)'}>
                <p class="home-articles__meta"><span>{article.journal}</span><time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time></p>
                <h3 class="home-articles__title"><PhraseText text={article.title} /></h3>
                <p class="home-articles__authors">{formatAuthors(article.authors)}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .home-articles {
    background: var(--surface-secondary);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .home-articles__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .home-articles__link {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    color: inherit;
    text-decoration: none;
  }
  .home-articles__link:focus-visible {
    outline: var(--p-border-strong) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  .home-articles__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .home-articles__meta span { color: var(--text-accent); }

  .home-articles__lead-title,
  .home-articles__title {
    margin: 0;
    font-weight: var(--fw-regular);
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .home-articles__lead-title { font-size: clamp(1.5rem, 2.6vw, 2rem); line-height: 1.12; }
  .home-articles__title { font-size: 1.25rem; line-height: 1.2; }

  .home-articles__link:hover :is(.home-articles__lead-title, .home-articles__title) {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .home-articles__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    overflow: hidden;
    max-width: 56ch;
    margin: 0;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.55;
  }

  .home-articles__authors {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-caption);
  }

  /* Same arrow link as the rest of the site, drawn on a span because the whole
     card is the link. */
  .home-articles__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    width: fit-content;
    min-height: var(--p-link-min-height);
    margin-top: 0.4rem;
    color: var(--text-link);
    font-size: var(--p-link-font-size);
    font-weight: var(--fw-medium);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: var(--p-action-underline-offset);
    text-decoration-color: color-mix(in srgb, currentColor 45%, transparent);
  }
  .home-articles__cta::after {
    content: '';
    width: 0.85em;
    height: 0.62em;
    background: currentColor;
    -webkit-mask: var(--p-action-arrow) center / contain no-repeat;
    mask: var(--p-action-arrow) center / contain no-repeat;
    transition: transform var(--p-duration-base) var(--p-ease-standard);
  }
  .home-articles__link:hover .home-articles__cta { text-decoration-color: currentColor; }
  .home-articles__link:hover .home-articles__cta::after { transform: translateX(3px); }

  .home-articles__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .home-articles__list li { padding-block: 1.25rem; border-top: var(--p-border-hairline) solid color-mix(in srgb, var(--text-primary) 18%, transparent); }
  .home-articles__list li:first-child { padding-top: 0; border-top: 0; }
  .home-articles__list li:last-child { padding-bottom: 0; }

  @media (min-width: 900px) {
    .home-articles__grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: 3rem; }
    .home-articles__list {
      padding-inline-start: 3rem;
      border-inline-start: var(--p-border-hairline) solid color-mix(in srgb, var(--text-primary) 18%, transparent);
      align-content: start;
    }
    .home-articles__list li:first-child { padding-top: 0; }
  }
</style>
