---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import articleData from '@/data/articles.json';
import { isRetractedArticle } from '@/lib/articleFilter.mjs';
import { getContent } from '@/i18n/content';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

const articles = [...articleData.articles]
  .filter((article) => !isRetractedArticle(article))
  .sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))
  .slice(0, 3);

function formatDate(value: string) {
  return new Intl.DateTimeFormat(locale, {
    year: 'numeric',
    month: 'short',
    day: '2-digit',
    timeZone: 'UTC',
  }).format(new Date(value + 'T00:00:00Z'));
}
---

<section class="row latest-articles">
  <div class="container-wide">
    <SectionHeading
      title={t('home.selectedArticles')}
      lede={t('home.selectedArticlesLede')}
    />

    <!-- Lead + two: the newest article gets room for its summary, the next
         two are compact. Avoids three identical text cards side by side. -->
    <ul class="latest-articles__list" role="list">
      {articles.map((article, index) => (
        <li class:list={['latest-articles__item', { 'latest-articles__item--lead': index === 0 }]}>
          <a
            href={article.url}
            class="latest-articles__link-card"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={article.title + ' (opens in a new tab)'}
          >
            <div class="latest-articles__meta">
              <span>{article.journal}</span>
              <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>
            </div>
            <h3>{article.title}</h3>
            {index === 0 && <p>{article.summary}</p>}
            <span class="latest-articles__authors">{article.authors.join(', ')}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .latest-articles {
    background: var(--surface-secondary);
    border-top: var(--p-border-hairline) solid var(--border-subtle);
    padding-block: 3.5rem 3.75rem;
  }

  .latest-articles :global(.section-heading__title) {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: var(--fw-regular);
    line-height: 1.12;
  }

  .latest-articles :global(.section-heading__lede) {
    margin-top: 0.5rem;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.45;
  }

  .latest-articles__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .latest-articles__item {
    min-width: 0;
    border-top: var(--p-border-hairline) solid var(--border-subtle);
  }

  .latest-articles__link-card {
    display: block;
    height: 100%;
    padding-block: 1.25rem 1.5rem;
    color: inherit;
    text-decoration: none;
  }

  .latest-articles__link-card:hover h3,
  .latest-articles__link-card:focus-visible h3 {
    color: var(--interactive-default);
  }

  .latest-articles__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .latest-articles__meta span { color: var(--text-accent); }

  .latest-articles__meta time {
    margin-inline-start: auto;
    font-weight: var(--fw-medium);
    white-space: nowrap;
  }

  .latest-articles h3 {
    max-width: 38ch;
    margin-top: 0.7rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--fw-regular);
    line-height: 1.2;
    transition: color var(--p-duration-fast) var(--p-ease-standard);
  }

  .latest-articles__item--lead h3 {
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
  }

  .latest-articles__link-card > p {
    max-width: 60ch;
    margin-top: 0.9rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.55;
    /* Feed summaries run to 80+ words; four lines is a teaser, not the abstract. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  .latest-articles__authors {
    display: block;
    margin-top: 0.85rem;
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  @media (min-width: 900px) {
    .latest-articles__list {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 3rem;
    }

    .latest-articles__item--lead {
      grid-row: 1 / span 2;
    }

    .latest-articles__item--lead .latest-articles__link-card {
      padding-block-end: 0;
    }
  }
</style>
