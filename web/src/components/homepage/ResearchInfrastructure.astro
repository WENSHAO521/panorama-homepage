---
import { externalSystems, getOfficeDirectory } from '@/data/site';
import { geoGraticule, geoNaturalEarth1, geoPath } from 'd3-geo';
import { feature, mesh } from 'topojson-client';
import worldAtlas from 'world-atlas/countries-110m.json' with { type: 'json' };
import Button from '@/components/ui/Button.astro';
import PhraseText from '@/components/ui/PhraseText.astro';
import { getContent } from '@/i18n/content';
import { localizePath } from '@/i18n/utils';

interface Props { locale?: string }
const { locale = Astro.currentLocale ?? 'en' } = Astro.props;
const t = getContent(locale);

// A plain world map: Natural Earth projection, countries without Antarctica,
// drawn at build time from world-atlas (no runtime JS, no extra request).
const W = 620;
const H = 316;
const topo = worldAtlas as any;
const countries = {
  type: 'GeometryCollection',
  geometries: topo.objects.countries.geometries.filter((g: any) => String(g.id) !== '010'),
};
const land = feature(topo, countries as any);
const projection = geoNaturalEarth1().rotate([-20, 0]).fitExtent([[2, 2], [W - 2, H - 2]], land as any);
const path = geoPath(projection);
const landPath = path(land as any) ?? '';
const bordersPath = path(mesh(topo, countries as any, (a: any, b: any) => a !== b)) ?? '';
const graticulePath = path(geoGraticule().step([30, 30])()) ?? '';

// The group's two real offices (src/data/site.ts), marked on the map.
const coordinates: Record<string, [number, number]> = {
  'hong-kong': [114.17, 22.32],
  nanjing: [118.8, 32.06],
};
const labelOffset: Record<string, [number, number]> = {
  nanjing: [-40, -24],
  'hong-kong': [-40, 30],
};
const pins = getOfficeDirectory(locale).map((office) => {
  const [x, y] = projection(coordinates[office.id]) as [number, number];
  const [dx, dy] = labelOffset[office.id];
  return {
    id: office.id,
    name: office.addressLocality.split(/[，,、]/)[0].trim(),
    x, y, lx: x + dx, ly: y + dy,
  };
});
---

<section class="row row--inverse research-infra" aria-labelledby="research-infra-title">
  <div class="container-wide research-infra__grid">
    <div class="research-infra__copy">
      <p class="text-overline">{t('home.researchOverline')}</p>
      <h2 id="research-infra-title" class="research-infra__title"><PhraseText text={t('home.researchTitle')} locale={locale} /></h2>
      <p class="research-infra__lede">
        {t('home.researchLede')}
      </p>
      <div class="research-infra__actions">
        <Button href={externalSystems.research} variant="primary" external>{t('common.visitResearch')}</Button>
        <a class="action-link" href={localizePath('/infrastructure/', locale)}>{t('common.viewInfrastructure')}</a>
      </div>
    </div>

    <figure class="research-infra__figure">
      <div class="research-map">
        <svg class="research-map__svg" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="research-map-title research-map-description">
          <title id="research-map-title">{t('home.connectedNetwork')}</title>
          <desc id="research-map-description">{t('home.mapDescription')}</desc>
          <path class="research-map__graticule" d={graticulePath} />
          <path class="research-map__land" d={landPath} />
          <path class="research-map__borders" d={bordersPath} />
          {pins.map((pin) => (
            <g class="research-map__pin" aria-hidden="true">
              <path class="research-map__leader" d={`M${pin.x} ${pin.y}L${pin.lx} ${pin.ly}`} />
              <circle class="research-map__halo" cx={pin.x} cy={pin.y} r="9" />
              <circle class="research-map__dot" cx={pin.x} cy={pin.y} r="3.6" />
            </g>
          ))}
        </svg>
        {pins.map((pin) => (
          <span class="research-map__label" aria-hidden="true" style={`left:${(pin.lx / W) * 100}%;top:${(pin.ly / H) * 100}%`}>{pin.name}</span>
        ))}
      </div>
    </figure>
  </div>
</section>

<style>
  /* The homepage's one dark band: it breaks up the run of paper rows
     between the hero and the journal sections. */
  .research-infra {
    --map-field: var(--surface-inverse);
    --focus-ring: var(--text-inverse);
    background: var(--map-field);
    color: var(--text-inverse);
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .research-infra__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: center;
  }

  .research-infra__title {
    max-width: 20ch;
    margin-top: 0.75rem;
    color: var(--text-inverse);
    font-size: clamp(1.9rem, 3.6vw, 2.75rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .research-infra__lede {
    max-width: 32rem;
    margin-top: 1rem;
    color: var(--text-inverse-muted-strong);
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .research-infra__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.9rem 1.5rem;
    margin-top: 1.5rem;
  }
  .research-infra__actions .action-link { color: var(--text-accent-inverse); }
  .research-infra__actions .action-link:hover { color: var(--text-inverse); }

  .research-infra__figure {
    position: relative;
    min-width: 0;
    margin: 0;
  }

  .research-map { position: relative; }

  .research-map__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: hidden;
  }

  .research-map__graticule {
    fill: none;
    stroke: var(--border-inverse);
    stroke-width: 0.6;
    opacity: 0.5;
  }

  .research-map__land {
    fill: color-mix(in srgb, var(--text-inverse) 16%, var(--map-field));
  }

  .research-map__borders {
    fill: none;
    stroke: var(--map-field);
    stroke-width: 0.6;
    stroke-linejoin: round;
  }

  .research-map__leader {
    fill: none;
    stroke: var(--text-accent-inverse);
    stroke-width: 0.9;
  }
  .research-map__halo { fill: var(--text-accent-inverse); opacity: 0.25; }

  /* The two office markers pulse twice when the band first loads, then rest. */
  @keyframes research-map-pulse {
    from { transform: scale(0.6); opacity: 0.4; }
    to { transform: scale(2.2); opacity: 0; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .research-map__halo {
      transform-box: fill-box;
      transform-origin: center;
      animation: research-map-pulse 2.4s ease-out 1s 2 backwards;
    }
  }
  .research-map__dot { fill: var(--text-accent-inverse); stroke: var(--map-field); stroke-width: 1.2; }

  /* Labels are HTML, not SVG text, so they keep their size on small screens. */
  .research-map__label {
    position: absolute;
    transform: translate(-100%, -50%);
    padding-inline-end: 0.4rem;
    color: var(--text-accent-inverse);
    font-size: var(--fs-label);
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .research-infra__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 1.35rem;
    }
  }

</style>
