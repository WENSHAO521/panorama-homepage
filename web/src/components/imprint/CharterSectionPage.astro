---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ImprintFooter from '@/components/imprint/ImprintFooter.astro';
import ImprintHeader from '@/components/imprint/ImprintHeader.astro';
import { getJournalCoverAsset } from '@/lib/assets/journalCovers';
import type { Imprint, Journal } from '@/types';
import { getNavigationLabels } from '@/i18n/navigation';
import { localizePath } from '@/i18n/utils';
import { imprintText } from '@/i18n/imprints';

type Section = 'journals' | 'research' | 'for-authors' | 'about';

interface Props {
  imprint: Imprint;
  journals: Journal[];
  section: Section;
}

const { imprint, journals, section } = Astro.props;
const basePath = '/imprints/charter/';
const pagePath = `${basePath}${section}/`;
const currentPath = Astro.url.pathname;
const wallpaper = '/images/publishing/charter-wallpaper-4k.jpg';
const locale = Astro.currentLocale ?? 'en';
const tx = (key: string, fallback: string) => imprintText('charter', locale, key, fallback);
const labels = getNavigationLabels(locale);
const localizedBasePath = localizePath(basePath, locale);

const navigation = [
  { label: labels.home, href: localizedBasePath },
  { label: labels.journals, href: localizePath(`${basePath}journals/`, locale), key: 'journals' },
  { label: labels.research, href: localizePath(`${basePath}research/`, locale), key: 'research' },
  { label: labels.forAuthors, href: localizePath(`${basePath}for-authors/`, locale), key: 'for-authors' },
  { label: labels.about, href: localizePath(`${basePath}about/`, locale), key: 'about' },
];
const imprintNav = navigation.map(({ label, href, key }) => ({ label, href, current: key === section }));
const footerNav = navigation.map(({ label, href }) => ({ label, href }));

const journalLabels: Record<string, string> = {
  pemr: 'Political economy & administration',
  cssr: 'Computational social science',
  jlpcs: 'Law, psychology & communication',
  irels: 'Education & learning',
  jscc: 'Social cognition & communication',
  cropt: 'Political thought',
  jpoii: 'Public oversight',
  ggsr: 'Global governance',
};

const journalSummaries: Record<string, string> = {
  jpoii: 'Work on accountability, transparency, and the integrity of institutions under public scrutiny.',
  ggsr: 'Studies of international institutions, global cooperation, and the systems that shape public life.',
};

const fields = [
  { key: 'law', title: 'Law', body: 'Legal reasoning, institutions, rights, and the conditions that make justice possible.' },
  { key: 'psychology', title: 'Psychology', body: 'Behaviour, judgement, identity, and the social conditions through which people act.' },
  { key: 'communication', title: 'Communication', body: 'Media, public discourse, digital governance, and the circulation of knowledge.' },
  { key: 'political', title: 'Political thought', body: 'Political ideas, intellectual history, democratic life, and public reason.' },
  { key: 'global', title: 'Global governance', body: 'International institutions, cooperation, accountability, and shared problems.' },
  { key: 'policy', title: 'Public policy', body: 'Evidence, implementation, administration, and the consequences of public decisions.' },
  { key: 'oversight', title: 'Public oversight', body: 'Transparency, integrity, institutional checks, and responsible authority.' },
  { key: 'computational', title: 'Computational social science', body: 'Data-intensive methods for studying people, institutions, and social systems.' },
  { key: 'education', title: 'Education', body: 'Learning, opportunity, teaching, and the policies that shape educational life.' },
  { key: 'society', title: 'Society', body: 'The relationships, structures, and inequalities that connect people and institutions.' },
];

const researchPrinciples = [
  { key: 'question', title: 'Question before conclusion', body: 'We value research that defines a meaningful question before reaching for a preferred answer.' },
  { key: 'method', title: 'Method proportional to claim', body: 'Methods, evidence, and interpretation should be aligned, transparent, and appropriate to the question.' },
  { key: 'context', title: 'Context is part of evidence', body: 'Institutions and publics are not abstractions. We encourage work that makes context and consequence visible.' },
  { key: 'interdisciplinary', title: 'Interdisciplinary with discipline', body: 'Cross-field work is strongest when it preserves the standards and vocabulary needed for serious scrutiny.' },
];

const authorSteps = [
  { number: '01', key: 'find', title: 'Find the right journal', body: 'Read the journal’s aims, scope, article types, and recent work before preparing a submission.' },
  { number: '02', key: 'argument', title: 'Make the argument inspectable', body: 'State the question, method, evidence, limitations, and relevant declarations with precision.' },
  { number: '03', key: 'submit', title: 'Submit through the journal', body: 'Use the official submission system and follow the current instructions for the selected journal.' },
  { number: '04', key: 'review', title: 'Engage with review', body: 'Respond to editorial and peer-review comments clearly, proportionately, and with a record of changes.' },
];

const commitments = [
  { key: 'independence', title: 'Editorial independence', body: 'Editorial decisions are guided by scholarly merit, relevance to scope, and the integrity of the record.' },
  { key: 'responsible', title: 'Responsible scholarship', body: 'We expect accurate reporting, appropriate attribution, ethical conduct, and disclosure of relevant interests.' },
  { key: 'publicValue', title: 'Public value', body: 'Research should be able to travel beyond its immediate field without losing the precision that makes it trustworthy.' },
  { key: 'durable', title: 'Durable records', body: 'Corrections, retractions, versioning, and post-publication stewardship are part of responsible publishing.' },
];

const pageContent = {
  journals: {
    kicker: 'Charter / Journals',
    title: 'A journal programme for public life.',
    lede: 'Charter brings together peer-reviewed journals that examine law, policy, governance, institutions, and society from complementary perspectives.',
  },
  research: {
    kicker: 'Charter / Research',
    title: 'Research for the systems we share.',
    lede: 'We publish scholarship that makes public institutions more understandable, more accountable, and better able to meet the complexity of contemporary life.',
  },
  'for-authors': {
    kicker: 'Charter / For authors',
    title: 'A rigorous route from idea to public scholarship.',
    lede: 'Charter welcomes original research, reviews, and perspectives that deepen understanding of law, policy, governance, and society.',
  },
  about: {
    kicker: 'Charter / About',
    title: 'A scholarly imprint for public life.',
    lede: 'Charter is a Panorama imprint for independent research on the institutions, relationships, and ideas that shape how people live together.',
  },
} as const;

const current = pageContent[section];
const localizedCurrent = {
  kicker: tx(`section.${section}.kicker`, current.kicker),
  title: tx(`section.${section}.title`, current.title),
  lede: tx(`section.${section}.lede`, current.lede),
};
const activeJournals = journals.filter((journal) => journal.status === 'active');
---

<BaseLayout
  title={`${localizedCurrent.kicker} | Charter`}
  description={localizedCurrent.lede}
  path={pagePath}
  locale={locale}
  showChrome={false}
>
  <div class="charter-secondary">
    <ImprintHeader imprint={imprint} links={imprintNav} locale={locale} currentPath={currentPath} />

    <main>
      <section class="charter-secondary__hero" aria-labelledby="charter-secondary-title">
        <Image class="charter-secondary__hero-wallpaper" src={wallpaper} alt="" width={3840} height={2160} widths={[960, 1440, 1920, 2880, 3840]} sizes="100vw" loading="eager" fetchpriority="high" />
        <div class="charter-secondary__hero-shade" aria-hidden="true"></div>
        <div class="charter-secondary__shell charter-secondary__hero-inner">
          <div>
            <p class="charter-secondary__kicker">{localizedCurrent.kicker}</p>
            <h1 id="charter-secondary-title">{localizedCurrent.title}</h1>
            <p class="charter-secondary__hero-lede">{localizedCurrent.lede}</p>
          </div>
          <aside class="charter-secondary__hero-note" aria-label={tx('section.heroNoteLabel', 'Charter focus')}>
            <span>{tx('keywordEvidence', 'Evidence')}</span>
            <span>{tx('keywordAccountability', 'Accountability')}</span>
            <span>{tx('section.publicLife', 'Public life')}</span>
            <span class="charter-secondary__hero-quote">{tx('section.heroQuoteOne', 'Independent research')}<br />{tx('section.heroQuoteTwo', 'for fairer systems.')}</span>
          </aside>
        </div>
      </section>

      {section === 'journals' && (
        <>
          <section class="charter-secondary__section" aria-labelledby="charter-journals-list-title">
            <div class="charter-secondary__shell">
              <div class="charter-secondary__section-bar">
                <p class="charter-secondary__kicker" id="charter-journals-list-title">{tx('section.journals.programmeKicker', 'The Charter journal programme')}</p>
                <p>{activeJournals.length} {tx('section.journals.activeJournals', 'active journals')}</p>
              </div>
              <div class="charter-secondary__journal-list">
                {activeJournals.map((journal, index) => {
                  const coverAsset = getJournalCoverAsset(journal.cover);
                  const description = tx(`journal.${journal.slug}.summary`, journal.description ?? journalSummaries[journal.slug] ?? 'Peer-reviewed research on institutions, public life, and the systems that connect them.');
                  const label = tx(`journal.${journal.slug}.label`, journalLabels[journal.slug] ?? journal.disciplines.join(' · '));
                  return (
                    <article class="charter-secondary__journal-row">
                      <div class="charter-secondary__journal-cover-wrap">
                        <span class="charter-secondary__journal-number">{String(index + 1).padStart(2, '0')}</span>
                        <a href={journal.journalUrl} target="_blank" rel="noopener noreferrer" aria-label={`${tx('visitJournal', 'Visit journal website')}: ${journal.title}`}>
                          {coverAsset ? (
                            <Image class="charter-secondary__journal-cover" src={coverAsset} alt={`${journal.title} cover`} width={495} height={700} widths={[180, 260, 360, 495]} sizes="(max-width: 639px) 11rem, (max-width: 900px) 14rem, 18rem" loading="lazy" />
                          ) : <div class="charter-secondary__cover-placeholder">{tx('coverForthcoming', 'Cover forthcoming')}</div>}
                        </a>
                      </div>
                      <div class="charter-secondary__journal-copy">
                        <p class="charter-secondary__eyebrow">{label}</p>
                        <h2><a href={journal.journalUrl} target="_blank" rel="noopener noreferrer">{journal.title}</a></h2>
                        <p>{description}</p>
                        <dl class="charter-secondary__journal-meta">
                          {journal.issn && <><dt>ISSN</dt><dd>{journal.issn}</dd></>}
                          <dt>{tx('access', 'Access')}</dt><dd>{journal.openAccess ? tx('openAccess', 'Open access') : tx('seeJournalWebsite', 'See journal website')}</dd>
                        </dl>
                        <div class="charter-secondary__link-row">
                          <a class="charter-secondary__text-link" href={journal.journalUrl} target="_blank" rel="noopener noreferrer">{tx('visitJournal', 'Visit journal website')}</a>
                          <a class="charter-secondary__quiet-link" href={journal.submissionUrl ?? journal.journalUrl} target="_blank" rel="noopener noreferrer">{tx('submissionInformation', 'Submission information')}</a>
                        </div>
                      </div>
                    </article>
                  );
                })}
              </div>
            </div>
          </section>
          <section class="charter-secondary__dark-statement" aria-labelledby="charter-journals-closing-title">
            <div class="charter-secondary__shell charter-secondary__dark-grid">
              <div><p class="charter-secondary__kicker">{tx('section.journals.closingKicker', 'A growing programme')}</p><h2 id="charter-journals-closing-title">{tx('section.journals.closingTitleOne', 'Different fields.')}<br />{tx('section.journals.closingTitleTwo', 'Shared standards.')}</h2></div>
              <div><p>{tx('section.journals.closingBody', 'Each Charter journal has its own editorial scope and community. Together, they share expectations for methodological care, editorial independence, transparent reporting, and responsible stewardship of the scholarly record.')}</p><a class="charter-secondary__inverse-link" data-action="secondary" href={localizePath(`${basePath}research/`, locale)}>{tx('section.journals.closingLink', 'Explore Charter research')}</a></div>
            </div>
          </section>
        </>
      )}

      {section === 'research' && (
        <>
          <section id="research" class="charter-secondary__dark-statement" aria-labelledby="charter-research-statement-title">
            <div class="charter-secondary__shell charter-secondary__dark-grid">
              <div><p class="charter-secondary__kicker">{tx('section.research.positionKicker', 'Our research position')}</p><h2 id="charter-research-statement-title">{tx('section.research.positionTitle', 'Public questions require public reasoning.')}</h2></div>
              <div><p>{tx('section.research.positionBodyOne', 'Law, policy, governance, and social life are connected systems. Decisions made in one part of public life can redistribute opportunity, authority, risk, and voice elsewhere.')}</p><p>{tx('section.research.positionBodyTwo', 'Charter publishes research that makes those relationships clearer without reducing complex questions to simple answers.')}</p></div>
            </div>
          </section>
          <section class="charter-secondary__section" aria-labelledby="charter-fields-title">
            <div class="charter-secondary__shell">
              <div class="charter-secondary__section-bar"><p class="charter-secondary__kicker" id="charter-fields-title">{tx('section.research.fieldsKicker', 'Fields of inquiry')}</p><p>{tx('section.research.fieldsMeta', 'Research across institutions and society.')}</p></div>
              <div class="charter-secondary__field-grid">
                {fields.map((field, index) => <article><span class="charter-secondary__field-marker">{String(index + 1).padStart(2, '0')}</span><h2>{tx(`field.${field.key}.title`, field.title)}</h2><p>{tx(`field.${field.key}.note`, field.body)}</p></article>)}
              </div>
            </div>
          </section>
          <section class="charter-secondary__section charter-secondary__section--tinted" aria-labelledby="charter-research-principles-title">
            <div class="charter-secondary__shell">
              <div class="charter-secondary__split-heading"><div><p class="charter-secondary__kicker">{tx('section.research.assessKicker', 'How we assess scholarship')}</p><h2 id="charter-research-principles-title">{tx('section.research.assessTitle', 'Open inquiry. Careful claims.')}</h2></div><p>{tx('section.research.assessBody', 'Charter supports scholarship that is ambitious in question and disciplined in method. Strong research can be critical, constructive, theoretical, empirical, or mixed-methods—as long as its reasoning is made available for scrutiny.')}</p></div>
              <div class="charter-secondary__principle-grid">{researchPrinciples.map((item) => <article><h3>{tx(`section.principle.${item.key}.title`, item.title)}</h3><p>{tx(`section.principle.${item.key}.body`, item.body)}</p></article>)}</div>
            </div>
          </section>
          <section class="charter-secondary__section" aria-labelledby="charter-research-link-title"><div class="charter-secondary__shell charter-secondary__closing-grid"><div><p class="charter-secondary__kicker">{tx('section.research.closingKicker', 'Continue with the programme')}</p><h2 id="charter-research-link-title">{tx('section.research.closingTitle', 'Read the journals shaping the conversation.')}</h2></div><a class="charter-secondary__text-link" data-action="secondary" href={localizePath(`${basePath}journals/`, locale)}>{tx('section.research.closingLink', 'Browse Charter journals')}</a></div></section>
        </>
      )}

      {section === 'for-authors' && (
        <>
          <section id="authors" class="charter-secondary__section" aria-labelledby="charter-author-process-title">
            <div class="charter-secondary__shell">
              <div class="charter-secondary__split-heading"><div><p class="charter-secondary__kicker">{tx('section.authors.beforeKicker', 'Before you submit')}</p><h2 id="charter-author-process-title">{tx('section.authors.processTitle', 'A clear route from research to publication.')}</h2></div><p>{tx('section.authors.processBody', 'Every Charter journal has its own aims, scope, and submission requirements. These shared principles help authors choose carefully and prepare responsibly.')}</p></div>
              <div class="charter-secondary__steps">{authorSteps.map((step) => <article><span>{step.number}</span><h3>{tx(`section.step.${step.key}.title`, step.title)}</h3><p>{tx(`section.step.${step.key}.body`, step.body)}</p></article>)}</div>
            </div>
          </section>
          <section class="charter-secondary__dark-statement" aria-labelledby="charter-author-standards-title">
            <div class="charter-secondary__shell charter-secondary__dark-grid"><div><p class="charter-secondary__kicker">{tx('section.authors.expectationsKicker', 'Shared expectations')}</p><h2 id="charter-author-standards-title">{tx('section.authors.expectationsTitle', 'Responsible scholarship is part of the submission.')}</h2></div><div><p>{tx('section.authors.expectationsBody', 'Authors should report methods and evidence accurately, acknowledge sources, disclose relevant interests, follow applicable ethical requirements, and make the limits of a study clear. Submissions may be declined when the record cannot be assessed with confidence.')}</p><div class="charter-secondary__link-row"><a class="charter-secondary__button" data-action="primary" href={localizePath('/standards/editorial/', locale)}>{tx('editorialStandards', 'Editorial standards')}</a><a class="charter-secondary__inverse-link" data-action="secondary" href={localizePath('/standards/ethics/', locale)}>{tx('publicationEthics', 'Publication ethics')}</a></div></div></div>
          </section>
          <section class="charter-secondary__section" aria-labelledby="charter-submission-title">
            <div class="charter-secondary__shell"><div class="charter-secondary__section-bar"><p class="charter-secondary__kicker" id="charter-submission-title">{tx('section.authors.submitKicker', 'Submit to a Charter journal')}</p><p>{activeJournals.length} {tx('section.authors.destinations', 'current destinations')}</p></div><div class="charter-secondary__submission-grid">{activeJournals.map((journal) => <article><p class="charter-secondary__eyebrow">{tx(`journal.${journal.slug}.label`, journalLabels[journal.slug] ?? journal.disciplines.join(' · '))}</p><h2>{journal.title}</h2><a class="charter-secondary__text-link" href={journal.submissionUrl ?? journal.journalUrl} target="_blank" rel="noopener noreferrer">{tx('openSubmission', 'Open submission system')}</a></article>)}</div></div>
          </section>
        </>
      )}

      {section === 'about' && (
        <>
          <section class="charter-secondary__section" aria-labelledby="charter-about-remit-title">
            <div class="charter-secondary__shell charter-secondary__about-grid"><div><p class="charter-secondary__kicker">{tx('section.about.remitKicker', 'Our remit')}</p><h2 id="charter-about-remit-title">{tx('section.about.remitTitle', 'A home for scholarship that takes public life seriously.')}</h2></div><div class="charter-secondary__prose"><p>{tx('section.about.remitBodyOne', 'Charter is the law, policy, governance, and society imprint of Panorama Scholarly Group. We publish research on the institutions and relationships through which people make decisions, distribute authority, and live together.')}</p><p>{tx('section.about.remitBodyTwo', 'Our programme is open to work that is rigorous in method, explicit in reasoning, and attentive to the consequences of knowledge in the world.')}</p><a class="charter-secondary__text-link" data-action="secondary" href={localizePath(`${basePath}journals/`, locale)}>{tx('section.about.remitLink', 'Explore the Charter journal programme')}</a></div></div>
          </section>
          <section class="charter-secondary__section charter-secondary__section--tinted" aria-labelledby="charter-about-commitments-title">
            <div class="charter-secondary__shell"><div class="charter-secondary__section-bar"><p class="charter-secondary__kicker" id="charter-about-commitments-title">{tx('section.about.guidesKicker', 'What guides us')}</p><p>{tx('section.about.guidesMeta', 'Commitments for a durable scholarly record.')}</p></div><div class="charter-secondary__principle-grid charter-secondary__principle-grid--four">{commitments.map((item, index) => <article><span class="charter-secondary__field-marker">{String(index + 1).padStart(2, '0')}</span><h3>{tx(`section.commitment.${item.key}.title`, item.title)}</h3><p>{tx(`section.commitment.${item.key}.body`, item.body)}</p></article>)}</div></div>
          </section>
          <section class="charter-secondary__dark-statement" aria-labelledby="charter-about-group-title"><div class="charter-secondary__shell charter-secondary__dark-grid"><div><p class="charter-secondary__kicker">{tx('section.about.groupKicker', 'Part of Panorama')}</p><h2 id="charter-about-group-title">{tx('section.about.groupTitle', 'Independent editorial worlds. A shared commitment to scholarship.')}</h2></div><div><p>{tx('section.about.groupBody', 'Charter is one of Panorama Scholarly Group’s publishing imprints. The group provides a common publishing infrastructure and shared standards while preserving the editorial identity and responsibility of each journal.')}</p><a class="charter-secondary__inverse-link" data-action="secondary" href={localizePath('/standards/editorial/', locale)}>{tx('section.about.groupLink', 'Read our editorial standards')}</a></div></div></section>
          <section class="charter-secondary__section" aria-labelledby="charter-about-contact-title"><div class="charter-secondary__shell charter-secondary__closing-grid"><div><p class="charter-secondary__kicker">{tx('section.about.contactKicker', 'Questions and proposals')}</p><h2 id="charter-about-contact-title">{tx('section.about.contactTitle', 'Start with the journal closest to your work.')}</h2></div><a class="charter-secondary__text-link" data-action="secondary" href={localizePath(`${basePath}for-authors/`, locale)}>{tx('section.about.contactLink', 'For authors and editors')}</a></div></section>
        </>
      )}
    </main>

    <ImprintFooter
      imprint={imprint}
      links={footerNav}
      locale={locale}
      theme="dark"
      tagline={tx('footerTagline', 'Independent research for a fairer society.')}
    />
  </div>
</BaseLayout>

<style>
  .charter-secondary { --cs-paper: var(--p-paper-50); --cs-paper-deep: var(--p-paper-100); --cs-ink: var(--p-navy-950); --cs-ink-soft: var(--p-navy-700); --cs-line: var(--p-stone-300); --cs-red: #a43331; --cs-gold: #a8701e; --cs-gold-ink: #7b5616; --cs-gold-light: #d7a063; --cs-teal: var(--p-teal-800); --imprint-accent: var(--cs-red); --cs-shell: min(100% - 7rem, 1480px); overflow: hidden; background: var(--cs-paper); color: var(--cs-ink); }
  .charter-secondary__shell { width: var(--cs-shell); margin-inline: auto; }
  .charter-secondary__header { position: relative; z-index: 10; border-bottom: 1px solid color-mix(in srgb, var(--cs-ink) 18%, transparent); background: var(--cs-paper); }
  .charter-secondary__header-inner { display: flex; align-items: center; gap: 2rem; min-height: 5rem; }
  .charter-secondary__brands { display: flex; align-items: center; flex: 0 0 auto; gap: 1rem; }
  .charter-secondary__divider { width: 1px; height: 2.25rem; background: var(--cs-line); }
  .charter-secondary__brand { display: inline-flex; align-items: center; gap: 1.2rem; color: inherit; text-decoration: none; }
  .charter-secondary__brand img { display: block; width: 13rem; height: auto; }
  .charter-secondary__nav { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2.2rem); margin-inline-start: auto; }
  .charter-secondary__nav a, .charter-secondary__footer a { color: var(--cs-ink); font-size: 0.65rem; font-weight: 750; letter-spacing: 0.06em; text-decoration: none; }
  .charter-secondary__nav a[aria-current='page'] { color: var(--cs-red); }
  .charter-secondary__search { padding-inline-start: 1.5rem; border-inline-start: 1px solid var(--cs-line); }
  .charter-secondary__tools { display: flex; align-items: center; gap: 1rem; margin-inline-start: 0.4rem; }
  .charter-secondary__lang { padding-inline-start: 1rem; border-inline-start: 1px solid var(--cs-line); }
  .charter-secondary__lang :global(.lang-switcher__trigger) { color: var(--cs-ink); }
  .charter-secondary__menu-button { display: none; width: 2.6rem; height: 2.6rem; padding: 0.7rem 0.5rem; border: 1px solid var(--cs-ink); border-radius: var(--p-radius-button); background: transparent; }
  .charter-secondary__menu-button span:not(.visually-hidden) { display: block; width: 100%; height: 1px; margin: 0.3rem 0; background: var(--cs-ink); }
  .charter-secondary__mobile-nav { display: none; }

  .charter-secondary__hero { position: relative; isolation: isolate; min-height: clamp(34rem, 53vw, 49rem); overflow: hidden; background: var(--cs-ink); color: var(--cs-paper); }
  .charter-secondary__hero-wallpaper { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 72% center; }
  .charter-secondary__hero-shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, color-mix(in srgb, var(--cs-ink) 96%, transparent) 0%, color-mix(in srgb, var(--cs-ink) 88%, transparent) 44%, color-mix(in srgb, var(--cs-ink) 40%, transparent) 100%); }
  .charter-secondary__hero-inner { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(18rem, 0.55fr); align-items: end; min-height: inherit; padding-block: clamp(4rem, 8vw, 7rem); }
  .charter-secondary__kicker { margin: 0; color: var(--cs-gold-ink); font-size: 0.6rem; font-weight: 800; letter-spacing: 0.2em; line-height: 1.35; text-transform: uppercase; }
  .charter-secondary__hero .charter-secondary__kicker,
  .charter-secondary__dark-statement .charter-secondary__kicker { color: var(--cs-gold-light); }
  .charter-secondary__hero h1 { max-width: 11ch; margin: 1.4rem 0 1.6rem; color: var(--cs-paper); font-family: var(--font-display); font-size: clamp(3.2rem, 6.2vw, 6.4rem); font-weight: 500; letter-spacing: -0.065em; line-height: 0.9; }
  .charter-secondary__hero-lede { max-width: 40rem; margin: 0; color: color-mix(in srgb, var(--cs-paper) 88%, transparent); font-family: var(--font-display); font-size: clamp(1.05rem, 1.55vw, 1.4rem); line-height: 1.4; }
