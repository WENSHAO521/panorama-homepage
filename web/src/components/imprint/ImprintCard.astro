---
import type { Imprint } from '@/types';
import { Image } from 'astro:assets';
import { localizePath } from '@/i18n/utils';

interface Props { imprint: Imprint; locale?: string; count?: number; countLabel?: string; covers?: ImageMetadata[] }
const { imprint, locale = Astro.currentLocale ?? 'en', count, countLabel, covers = [] } = Astro.props;
const countJoin = ['zh-hans', 'zh-hant', 'ja', 'ko'].includes(locale) ? '' : ' ';
---

<li class={`imprint-card imprint-card--${imprint.slug}`} data-imprint-theme={imprint.slug}>
  <a href={localizePath(`/imprints/${imprint.slug}/`, locale)} class="imprint-card__link">
    {count !== undefined && <span class="imprint-card__count">{count}{countJoin}{countLabel}</span>}
    <span class="imprint-card__mark"><img class="imprint-card__logo" src={imprint.logo} alt={imprint.name} loading="lazy" /></span>
    <span class="imprint-card__scope">{imprint.scope}</span>
    {covers.length > 0 && (
      <span class="imprint-card__covers" aria-hidden="true">
        {covers.map((cover) => <Image src={cover} alt="" widths={[120, 200]} sizes="6rem" loading="lazy" />)}
      </span>
    )}
  </a>
</li>

<style>
  .imprint-card {
    display: flex;
    min-width: 0;
  }

  /* Tinted tile with the imprint colour as a top rule; the tint comes from
     the imprint theme (data-imprint-theme on the card). */
  .imprint-card {
    position: relative;
    flex-direction: column;
    overflow: hidden;
    background: var(--imprint-tint-strong, var(--surface-secondary));
    border-top: 4px solid var(--imprint-accent-rule, var(--border-strong));
    border-radius: var(--p-radius-card);
  }
  .imprint-card--ridgeline { --imprint-accent-rule: var(--p-imprint-ridgeline); }
  .imprint-card--health-nexus { --imprint-accent-rule: var(--p-imprint-health-nexus); }
  .imprint-card--verdant-science { --imprint-accent-rule: var(--p-imprint-verdant-science); }
  .imprint-card--charter { --imprint-accent-rule: var(--p-imprint-charter); }
  .imprint-card--threnody { --imprint-accent-rule: var(--p-imprint-threnody); }

  .imprint-card__link {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    padding: 1.35rem 1.25rem 0;
    text-decoration: none;
  }

  /* The marks are scaled to different heights (below), so they sit in a box
     sized for the tallest one and share its bottom edge; the scope line and
     count then start at the same height in every card. */
  .imprint-card__mark {
    display: flex;
    align-items: flex-end;
    height: calc(var(--logo-base) * 1.22);
  }
  .imprint-card__scope { color: var(--text-secondary); font-size: 0.8rem; line-height: 1.4; hyphens: auto; overflow-wrap: break-word; }
  .imprint-card__count { color: var(--text-secondary); font-size: var(--fs-label); font-weight: var(--fw-semibold); letter-spacing: 0.1em; text-transform: uppercase; }

  /* Three covers fanned at the foot of the card, bleeding off its bottom edge. */
  .imprint-card__covers {
    display: flex;
    align-items: flex-end;
    height: 7.5rem;
    margin-top: auto;
    padding-top: 1rem;
    padding-inline-start: 0.2rem;
  }
  .imprint-card__covers :global(img) {
    flex: none;
    width: 42%;
    height: auto;
    aspect-ratio: 495 / 700;
    object-fit: cover;
    box-shadow: 0 10px 18px -8px rgb(31 27 25 / 0.45);
    transform-origin: bottom center;
    transition: transform var(--p-duration-slow) var(--p-ease-decelerate);
  }
  .imprint-card__covers :global(img + img) { margin-inline-start: -14%; }
  .imprint-card__covers :global(img:nth-child(1)) { transform: rotate(-5deg) translateY(1.2rem); }
  .imprint-card__covers :global(img:nth-child(2)) { z-index: 2; transform: translateY(0.7rem); }
  .imprint-card__covers :global(img:nth-child(3)) { z-index: 1; transform: rotate(5deg) translateY(1.3rem); }
  @media (hover: hover) {
    .imprint-card__link:hover .imprint-card__covers :global(img:nth-child(1)) { transform: rotate(-8deg) translateY(0.9rem); }
    .imprint-card__link:hover .imprint-card__covers :global(img:nth-child(2)) { transform: translateY(0.2rem); }
    .imprint-card__link:hover .imprint-card__covers :global(img:nth-child(3)) { transform: rotate(8deg) translateY(1rem); }
  }
  /* Inset ring: the card clips its overflow, so an outset ring would be cut off. */
  .imprint-card__link:focus-visible {
    outline: var(--p-border-strong) solid var(--focus-ring);
    outline-offset: -4px;
  }

  /* One optical size for all five wordmarks. The SVGs carry different
     internal whitespace and letterforms, so each gets a scale factor tuned
     by eye against the others (cap height roughly equal). */
  .imprint-card { --logo-base: 1.9rem; --logo-scale: 1; }
  .imprint-card--ridgeline { --logo-scale: 1.12; }
  .imprint-card--health-nexus { --logo-scale: 0.86; }
  .imprint-card--verdant-science { --logo-scale: 1.22; }
  .imprint-card--charter { --logo-scale: 1.02; }
  .imprint-card--threnody { --logo-scale: 1.2; }

  .imprint-card__logo {
    display: block;
    width: auto;
    height: calc(var(--logo-base) * var(--logo-scale));
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  /* Phones: one card per row, text on the left and the covers on the right,
     so five cards don't become five tall tiles. */
  @media (max-width: 639px) {
    .imprint-card__link {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 7.5rem;
      column-gap: 1rem;
      align-content: start;
      padding-bottom: 0;
    }
    .imprint-card__link > :not(.imprint-card__covers) { grid-column: 1; }
    .imprint-card__covers {
      grid-column: 2;
      grid-row: 1 / span 3;
      align-self: end;
      height: 6.5rem;
      margin-top: 0;
      padding-top: 0;
    }
    .imprint-card__link { min-height: 8.5rem; }
    .imprint-card__scope { padding-bottom: 1.25rem; }
  }
</style>
