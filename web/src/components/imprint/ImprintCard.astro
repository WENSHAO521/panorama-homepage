---
import type { Imprint } from '@/types';
import { localizePath } from '@/i18n/utils';

interface Props { imprint: Imprint; locale?: string }
const { imprint, locale = Astro.currentLocale ?? 'en' } = Astro.props;
---

<li class={`imprint-card imprint-card--${imprint.slug}`} style={`--accent: ${imprint.accent}`}>
  <a href={localizePath(`/imprints/${imprint.slug}/`, locale)} class="imprint-card__link">
    <img class="imprint-card__logo" src={imprint.logo} alt={imprint.name} loading="lazy" />
  </a>
</li>

<style>
  .imprint-card {
    min-width: 0;
  }

  .imprint-card__link {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    min-height: 5.9rem;
    padding: 1rem 0.35rem 1.25rem;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--p-duration-base) var(--p-ease-standard);
  }

  .imprint-card__link:hover { background: transparent; }

  .imprint-card__logo {
    display: block;
    width: min(100%, 10.5rem);
    height: 3.2rem;
    object-fit: contain;
  }

  .imprint-card--verdant-science .imprint-card__logo,
  .imprint-card--threnody .imprint-card__logo {
    height: 3.6rem;
  }

  @media (max-width: 639px) {
    .imprint-card__link { min-height: 5rem; }
  }
</style>
