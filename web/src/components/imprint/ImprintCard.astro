---
import type { Imprint } from '@/types';
import { localizePath } from '@/i18n/utils';

interface Props { imprint: Imprint; locale?: string; count?: number; countLabel?: string }
const { imprint, locale = Astro.currentLocale ?? 'en', count, countLabel } = Astro.props;
---

<li class={`imprint-card imprint-card--${imprint.slug}`}>
  <a href={localizePath(`/imprints/${imprint.slug}/`, locale)} class="imprint-card__link">
    <img class="imprint-card__logo" src={imprint.logo} alt={imprint.name} loading="lazy" />
    <span class="imprint-card__scope">{imprint.scope}</span>
    {count !== undefined && <span class="imprint-card__count">{count} {countLabel}</span>}
  </a>
</li>

<style>
  .imprint-card {
    display: flex;
    min-width: 0;
  }

  .imprint-card { flex-direction: column; border-top: 3px solid var(--imprint-accent-rule, var(--border-strong)); }
  .imprint-card--ridgeline { --imprint-accent-rule: var(--p-imprint-ridgeline); }
  .imprint-card--health-nexus { --imprint-accent-rule: var(--p-imprint-health-nexus); }
  .imprint-card--verdant-science { --imprint-accent-rule: var(--p-imprint-verdant-science); }
  .imprint-card--charter { --imprint-accent-rule: var(--p-imprint-charter); }
  .imprint-card--threnody { --imprint-accent-rule: var(--p-imprint-threnody); }

  .imprint-card__link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding-block: 1rem 0.25rem;
    text-decoration: none;
    border-radius: var(--p-radius-button);
    transition: transform var(--p-duration-base) var(--p-ease-standard);
  }
  .imprint-card__link:hover { transform: translateY(-0.2rem); }

  .imprint-card__logo { align-self: flex-start; }
  .imprint-card__scope { color: var(--text-secondary); font-size: 0.8rem; line-height: 1.4; }
  .imprint-card__count { color: var(--text-primary); font-size: 0.7rem; font-weight: var(--fw-semibold); letter-spacing: 0.06em; }
  .imprint-card__link:focus-visible {
    outline: var(--p-border-strong) solid var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  /* One optical size for all five wordmarks. The SVGs carry different
     internal whitespace and letterforms, so each gets a scale factor tuned
     by eye against the others (cap height roughly equal). */
  .imprint-card { --logo-base: 1.9rem; --logo-scale: 1; }
  .imprint-card--ridgeline { --logo-scale: 1.12; }
  .imprint-card--health-nexus { --logo-scale: 0.86; }
  .imprint-card--verdant-science { --logo-scale: 1.22; }
  .imprint-card--charter { --logo-scale: 1.02; }
  .imprint-card--threnody { --logo-scale: 1.2; }

  .imprint-card__logo {
    display: block;
    width: auto;
    height: calc(var(--logo-base) * var(--logo-scale));
    max-width: 100%;
  }

  /* 640-1199px: the five marks at full size don't fit on one line; scale
     them together rather than letting the last one wrap alone. */
  @media (min-width: 640px) and (max-width: 1199px) {
    .imprint-card { --logo-base: 1.55rem; }
  }
</style>
