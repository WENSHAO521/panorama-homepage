---
import LanguageSwitcher from '@/components/navigation/LanguageSwitcher.astro';
import { getUiStrings } from '@/i18n/locales';
import { localizePath } from '@/i18n/utils';

interface Props {
  locale?: string;
  currentPath?: string;
  class?: string;
}

const { locale = 'en', currentPath = '/', class: className } = Astro.props;
const t = getUiStrings(locale);
---

<div class:list={['header-tools', className]}>
  <a class="header-tools__search" href={localizePath('/search/', locale)} aria-label={t.search}>
    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
      <circle cx="9" cy="9" r="6.25" fill="none" stroke="currentColor" stroke-width="1.6" />
      <path d="M14 14l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
    <span class="header-tools__search-label">{t.search}</span>
  </a>

  <div class="header-tools__lang site-header__lang">
    <LanguageSwitcher currentLocale={locale} currentPath={currentPath} />
  </div>
</div>

<style>
  .header-tools {
    display: flex;
    align-items: center;
    min-height: 2.5rem;
    color: inherit;
  }

  .header-tools__search {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.5rem;
    padding: 0.5rem var(--p-space-4) 0.5rem 0;
    border-radius: var(--p-radius-button);
    color: inherit;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .header-tools__search svg {
    display: block;
    flex: 0 0 auto;
    width: 1.08rem;
    height: 1.08rem;
  }

  .header-tools__search:hover,
  .header-tools__search:focus-visible {
    color: var(--header-tools-hover, var(--interactive-default));
  }

  .header-tools__lang {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    margin-inline-start: 0;
    padding-inline-start: var(--p-space-4);
    border-inline-start: 1px solid var(--header-tools-line, color-mix(in srgb, currentColor 28%, transparent));
  }

  .header-tools__lang :global(.lang-switcher__trigger) {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    color: inherit;
    font-size: 0.68rem;
    font-weight: 650;
    letter-spacing: 0.03em;
    line-height: 1;
    padding: 0.5rem 0.35rem;
  }

  .header-tools__lang :global(.lang-switcher__trigger:hover),
  .header-tools__lang :global(.lang-switcher__trigger:focus-visible) {
    color: var(--header-tools-hover, var(--interactive-default));
  }

  @media (max-width: 767px) {
    .header-tools__search-label,
    .header-tools__lang { display: none; }

    .header-tools__search { padding-inline: 0.35rem; }
  }
</style>
