---
// Semantic breadcrumb trail with BreadcrumbList structured data (project
// brief §26). `items` excludes the current page's own Home root -- this
// component always prepends it. The final item renders as plain text
// (aria-current="page"), not a link, since it's the page the user is on.
import { breadcrumbJsonLd } from '@/lib/seo/structuredData';

export interface Crumb {
  label: string;
  path?: string;
}

interface Props {
  items: Crumb[];
}
const { items } = Astro.props;
const trail: Crumb[] = [{ label: 'Home', path: '/' }, ...items];
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol class="breadcrumbs__list">
    {trail.map((crumb, i) => (
      <li class="breadcrumbs__item">
        {i === trail.length - 1 || !crumb.path ? (
          <span aria-current="page">{crumb.label}</span>
        ) : (
          <a href={crumb.path}>{crumb.label}</a>
        )}
        {i < trail.length - 1 && <span class="breadcrumbs__sep" aria-hidden="true">›</span>}
      </li>
    ))}
  </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd(trail))} />

<style>
  .breadcrumbs {
    font-size: var(--fs-caption);
  }
  .breadcrumbs__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: var(--p-space-1);
  }
  .breadcrumbs__item {
    display: inline-flex;
    align-items: center;
    gap: var(--p-space-1);
  }
  .breadcrumbs__item a {
    color: var(--text-muted);
    text-decoration: none;
  }
  .breadcrumbs__item a:hover {
    color: var(--interactive-default);
  }
  .breadcrumbs__item span[aria-current] {
    color: var(--text-secondary);
    font-weight: var(--fw-medium);
  }
  .breadcrumbs__sep {
    color: var(--border-strong);
  }
</style>
