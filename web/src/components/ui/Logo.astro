---
interface Props {
  href?: string;
  inverse?: boolean;
}
import { getContent, fill } from '@/i18n/content';
const { href = '/', inverse = false } = Astro.props;
const homeLabel = fill(getContent(Astro.currentLocale ?? 'en')('common.homeLabel'), { name: 'Panorama Scholarly Group' });
---

<a href={href} class:list={['logo', { 'logo--inverse': inverse }]} aria-label={homeLabel}>
  <span class="logo__name">PANORAMA</span>
  <span class="logo__sub">SCHOLARLY GROUP</span>
</a>

<style>
  .logo {
    display: inline-flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: flex-start;
    color: var(--logo-ink);
    text-decoration: none;
    line-height: 1;
  }

  .logo__name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: var(--fw-semibold);
    letter-spacing: -0.02em;
  }

  .logo__sub {
    margin-top: 0.2rem;
    color: var(--logo-sub);
    font-size: 0.42rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.15em;
  }

  .logo--inverse {
    color: var(--logo-inverse) !important;
  }

  .logo--inverse .logo__name {
    color: var(--logo-inverse) !important;
  }

  .logo--inverse .logo__sub {
    color: var(--logo-inverse-sub) !important;
  }
</style>
