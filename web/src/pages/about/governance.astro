---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AboutSubnav from '@/components/about/AboutSubnav.astro';
import Button from '@/components/ui/Button.astro';
import { getGovernanceCopy } from '@/i18n/group';
import { localizePath } from '@/i18n/utils';
import GroupHero from '@/components/group/GroupHero.astro';

const locale = Astro.currentLocale ?? 'en';
const copy = getGovernanceCopy(locale);
const localizedBasePath = localizePath('/about/governance/', locale);
---

<BaseLayout
  title={copy.title}
  description={copy.metaDescription}
  path="/about/governance/"
  locale={locale}
>
  <div class="governance-page">
    <AboutSubnav currentPath={localizedBasePath} locale={locale} />

    <GroupHero eyebrow={copy.overline} title={copy.heroTitle} lede={copy.heroLede} titleId="governance-title">
      <div slot="aside" class="governance-hero__aside-content" aria-label={copy.briefLabel}>
        <p class="text-overline">{copy.briefLabel}</p>
        <dl>
          {copy.brief.map((item) => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
        </dl>
      </div>
    </GroupHero>

    <section class="governance-intro row" aria-labelledby="governance-intro-title">
      <div class="container-wide governance-intro__grid">
        <div>
          <p class="text-overline">{copy.framework}</p>
          <h2 id="governance-intro-title">{copy.introTitle}</h2>
        </div>
        <div class="governance-intro__copy">
          {copy.introParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>
    </section>

    <section class="governance-practices row" aria-labelledby="practices-title">
      <div class="container-wide">
        <header class="governance-section-head">
          <div>
            <p class="text-overline">{copy.howItWorks}</p>
            <h2 id="practices-title">{copy.practicesTitle}</h2>
          </div>
          <p>{copy.practicesIntro}</p>
        </header>

        <ol class="governance-practice-list">
          {copy.practices.map((practice, index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{practice.title}</h3>
                <p>{practice.body}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="governance-responsibilities row row--inverse" aria-labelledby="responsibilities-title">
      <div class="container-wide">
        <header class="governance-section-head governance-section-head--inverse">
          <div>
            <p class="text-overline">{copy.sharedResponsibility}</p>
            <h2 id="responsibilities-title">{copy.responsibilitiesTitle}</h2>
          </div>
          <p>{copy.responsibilitiesIntro}</p>
        </header>

        <div class="governance-responsibility-list">
          {copy.responsibilities.map((responsibility, index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{responsibility.title}</h3>
              <p>{responsibility.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="governance-closing row" aria-labelledby="governance-closing-title">
      <div class="container-wide governance-closing__inner">
        <div>
          <p class="text-overline">{copy.standardsOverline}</p>
          <h2 id="governance-closing-title">{copy.closingTitle}</h2>
        </div>
        <div class="governance-closing__copy">
          <p>{copy.closingBody}</p>
          <div class="governance-closing__actions">
            <Button href={localizePath('/standards/editorial/', locale)} variant="primary">{copy.editorialStandards}</Button>
            <Button href={localizePath('/standards/ethics/', locale)} variant="secondary">{copy.publicationEthics}</Button>
            <Button href={localizePath('/about/contact/', locale)} variant="secondary">{copy.raiseQuestion}</Button>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .governance-page { background: var(--surface-primary); }

  .governance-hero { border-bottom: var(--p-border-hairline) solid var(--border-subtle); }

  .governance-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(3rem, 10vw, 10rem);
    align-items: end;
    min-height: 30rem;
    padding-block: clamp(4rem, 8vw, 7rem) clamp(3.5rem, 7vw, 6rem);
  }

  .governance-hero__copy h1 {
    max-width: 11ch;
    margin-top: 0.75rem;
    font-size: clamp(3rem, 5.8vw, 5.5rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.05em;
    line-height: 0.98;
  }

  .governance-hero__lede {
    max-width: 38rem;
    margin-top: 1.8rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.45;
  }

  .governance-hero__index {
    border-top: var(--p-border-strong) solid var(--brand-accent);
    padding-top: 1rem;
  }

  .governance-hero__index .text-overline { color: var(--interactive-default); }
  .governance-hero__index dl { margin: 1rem 0 0; }

  .governance-hero__index dl > div {
    display: grid;
    grid-template-columns: minmax(5rem, 0.7fr) minmax(0, 1.3fr);
    gap: 1rem;
    padding-block: 0.9rem;
    border-top: var(--p-border-hairline) solid var(--border-subtle);
  }

  .governance-hero__index dt,
  .governance-hero__index dd { margin: 0; }

  .governance-hero__index dt {
    color: var(--text-muted);
    font-size: 0.62rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .governance-hero__index dd {
    font-family: var(--font-display);
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .row { border-bottom: var(--p-border-hairline) solid var(--border-subtle); }

  .governance-intro,
  .governance-practices,
  .governance-closing { padding-block: clamp(4rem, 8vw, 7rem); }

  .governance-intro__grid,
  .governance-closing__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 9vw, 9rem);
    align-items: start;
  }

  .governance-intro h2,
  .governance-closing h2 {
    max-width: 14ch;
    margin-top: 0.7rem;
    font-size: clamp(2.25rem, 4vw, 3.75rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .governance-intro__copy { padding-top: 0.3rem; }

  .governance-intro__copy p,
  .governance-closing__copy > p {
    max-width: 38rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.55vw, 1.2rem);
    line-height: 1.5;
  }

  .governance-intro__copy p + p {
    margin-top: 1.2rem;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .governance-section-head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr);
    gap: clamp(2rem, 8vw, 8rem);
    align-items: end;
  }

  .governance-section-head h2 {
    max-width: 15ch;
    margin-top: 0.7rem;
    font-size: clamp(2.3rem, 4vw, 3.8rem);
    font-weight: var(--fw-regular);
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  .governance-section-head > p {
    max-width: 30rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.5;
  }

  .governance-practice-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 3.25rem 0 0;
    padding: 0;
    border-top: var(--p-border-hairline) solid var(--border-strong);
    list-style: none;
  }

  .governance-practice-list li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1.25rem;
    min-height: 12rem;
    padding: 1.25rem 1.4rem 1.5rem;
    border-inline-end: var(--p-border-hairline) solid var(--border-strong);
    border-bottom: var(--p-border-hairline) solid var(--border-strong);
  }

  .governance-practice-list li:nth-child(2n) { border-inline-end: 0; }
  .governance-practice-list li:nth-child(n + 3) { border-bottom: 0; }
  .governance-practice-list li:first-child { padding-inline-start: 0; }

  .governance-practice-list span,
  .governance-responsibility-list span {
    font-family: var(--font-display);
    font-size: 1.7rem;
    line-height: 1;
  }

  .governance-practice-list span { color: var(--text-accent); }
  .governance-responsibility-list span { color: var(--text-accent-inverse); }

  .governance-practice-list h3 {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: var(--fw-regular);
  }

  .governance-practice-list p {
    max-width: 28rem;
    margin-top: 0.65rem;
    color: var(--text-secondary);
    font-family: var(--font-display);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .governance-responsibilities {
    border-bottom: 0;
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .governance-section-head--inverse .text-overline { color: var(--text-accent-inverse); }
  .governance-section-head--inverse h2 { color: var(--text-inverse); }
  .governance-section-head--inverse > p { color: var(--text-inverse-muted); }

  .governance-responsibility-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: 3.25rem;
    border-top: var(--p-border-hairline) solid var(--border-inverse);
  }

  .governance-responsibility-list article {
    min-height: 12rem;
    padding: 1.2rem 1.3rem 1.3rem;
    border-inline-end: var(--p-border-hairline) solid var(--border-inverse);
  }

  .governance-responsibility-list article:first-child { padding-inline-start: 0; }
  .governance-responsibility-list article:last-child { border-inline-end: 0; }

  .governance-responsibility-list h3 {
    margin-top: 2.25rem;
    color: var(--text-inverse);
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: var(--fw-regular);
  }

  .governance-responsibility-list p {
    max-width: 18rem;
    margin-top: 0.55rem;
    color: var(--text-inverse-muted);
    font-family: var(--font-display);
    font-size: 0.88rem;
    line-height: 1.45;
  }

  .governance-closing__inner { align-items: end; }

  .governance-closing__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.6rem;
  }

  @media (max-width: 900px) {
    .governance-hero__inner { grid-template-columns: minmax(0, 1fr); gap: 3rem; }
    .governance-section-head { grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  }

  @media (max-width: 639px) {
    .governance-hero__inner { min-height: 0; padding-block: 3.5rem 3rem; }
    .governance-hero__copy h1 { max-width: 10ch; font-size: clamp(2.8rem, 13vw, 4rem); }
    .governance-hero__index dl > div { grid-template-columns: 1fr; gap: 0.3rem; }
    .governance-intro__grid,
    .governance-closing__inner { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .governance-intro h2,
    .governance-closing h2,
    .governance-section-head h2 { max-width: 12ch; font-size: clamp(2.25rem, 10vw, 3.3rem); }
    .governance-practice-list,
    .governance-responsibility-list { grid-template-columns: minmax(0, 1fr); }
    .governance-practice-list li,
    .governance-practice-list li:first-child,
    .governance-practice-list li:nth-child(2n),
    .governance-practice-list li:nth-child(n + 3) { min-height: 0; padding: 1.2rem 0; border-inline-end: 0; border-bottom: var(--p-border-hairline) solid var(--border-strong); }
    .governance-practice-list li:last-child { border-bottom: 0; }
    .governance-responsibility-list article,
    .governance-responsibility-list article:first-child { min-height: 0; padding: 1.2rem 0; border-inline-end: 0; border-bottom: var(--p-border-hairline) solid var(--border-inverse); }
    .governance-responsibility-list article:last-child { border-bottom: 0; }
    .governance-responsibility-list h3 { margin-top: 1.25rem; }
  }
</style>
