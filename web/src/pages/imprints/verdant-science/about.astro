---
import VerdantScienceSectionPage from '@/components/imprint/VerdantScienceSectionPage.astro';
import { getImprintBySlug, getJournalsForImprint } from '@/lib/content/imprints';

const imprint = getImprintBySlug('verdant-science');
if (!imprint) throw new Error('Verdant Science imprint data is missing.');
const journals = getJournalsForImprint('verdant-science');
---

<VerdantScienceSectionPage imprint={imprint} journals={journals} section="about" />
