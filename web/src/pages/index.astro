---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/homepage/Hero.astro';
import ImprintGrid from '@/components/homepage/ImprintGrid.astro';
import FeaturedJournals from '@/components/homepage/FeaturedJournals.astro';
import ResearchInfrastructure from '@/components/homepage/ResearchInfrastructure.astro';
import LatestArticles from '@/components/homepage/LatestArticles.astro';
import LatestAnnouncements from '@/components/homepage/LatestAnnouncements.astro';
import InstitutionalPartner from '@/components/homepage/InstitutionalPartner.astro';
import { getContent } from '@/i18n/content';

const locale = Astro.currentLocale ?? 'en';
const t = getContent(locale);
---

<BaseLayout
  title={t('home.title')}
  description={t('home.metaDescription')}
  path="/"
  locale={locale}
>
  <Hero locale={locale} />

  <ImprintGrid locale={locale} />

  <ResearchInfrastructure locale={locale} />

  <FeaturedJournals locale={locale} />

  <LatestArticles locale={locale} />

  <LatestAnnouncements locale={locale} />

  <InstitutionalPartner locale={locale} />
</BaseLayout>

<script>
  // Sections below the hero fade up once as they enter the viewport. The
  // hidden state is only applied from JS, so no-JS and reduced-motion
  // visitors always see content immediately.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const sections = document.querySelectorAll<HTMLElement>('main > section:not(.hero)');
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-revealed');
        io.unobserve(entry.target);
      }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
    for (const section of sections) {
      if (section.getBoundingClientRect().top < window.innerHeight) continue;
      section.classList.add('reveal');
      io.observe(section);
    }
  }
</script>

<style is:global>
  main > section.reveal > * {
    opacity: 0;
    transform: translateY(1.25rem);
    transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  main > section.reveal.is-revealed > * {
    opacity: 1;
    transform: none;
  }
</style>
