---
import LegalPage from '@/components/legal/LegalPage.astro';
import { getPolicyCopy } from '@/i18n/policies';
import { getPolicyBody, renderPolicyHtml } from '@/i18n/policy-body';

const locale = Astro.currentLocale ?? 'en';
const policy = getPolicyCopy('privacy', locale);
const body = getPolicyBody('privacy', locale);
const render = (html: string) => renderPolicyHtml(html, locale);
const sections = [
  { id: 'scope', label: policy.sections.scope },
  { id: 'information', label: policy.sections.information },
  { id: 'use', label: policy.sections.use },
  { id: 'sharing', label: policy.sections.sharing },
  { id: 'retention', label: policy.sections.retention },
  { id: 'choices', label: policy.sections.choices },
  { id: 'changes-contact', label: policy.sections['changes-contact'] },
];
---

<LegalPage
  title={policy.title}
  description={policy.description}
  path="/privacy/"
  locale={locale}
  lede={policy.lede}
  updated="14 September 2026"
  sections={sections}
  railTitle={policy.railTitle}
  railText={policy.railText}
>
  {sections.map((section, index) => (
    <section class="legal-section" id={section.id}>
      <h2><span>{String(index + 1).padStart(2, '0')}</span>{section.label}</h2>
      <Fragment set:html={render(body.sections[section.id])} />
    </section>
  ))}
</LegalPage>
