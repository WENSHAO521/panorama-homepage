---
import LegalPage from '@/components/legal/LegalPage.astro';
import { getNavigationLabels } from '@/i18n/navigation';
import { getPolicyCopy } from '@/i18n/policies';
import { getPolicyBody, renderPolicyHtml } from '@/i18n/policy-body';

const locale = Astro.currentLocale ?? 'en';
const policy = getPolicyCopy('ethics', locale);
const body = getPolicyBody('ethics', locale);
const labels = getNavigationLabels(locale);
const render = (html: string) => renderPolicyHtml(html, locale);
const sections = [
  { id: 'purpose', label: policy.sections.purpose },
  { id: 'integrity', label: policy.sections.integrity },
  { id: 'authorship', label: policy.sections.authorship },
  { id: 'review', label: policy.sections.review },
  { id: 'disclosure', label: policy.sections.disclosure },
  { id: 'oversight', label: policy.sections.oversight },
  { id: 'concerns', label: policy.sections.concerns },
  { id: 'record', label: policy.sections.record },
  { id: 'appeals', label: policy.sections.appeals },
  { id: 'responsibility', label: policy.sections.responsibility },
];
---

<LegalPage
  title={policy.title}
  description={policy.description}
  path="/standards/ethics/"
  locale={locale}
  lede={policy.lede}
  updated="14 September 2026"
  sections={sections}
  relatedLinks={[
    { href: '/standards/editorial/', label: labels.editorialStandards },
    { href: '/standards/open-access/', label: labels.openAccess },
    { href: '/about/contact/', label: labels.contact },
  ]}
  railTitle={policy.railTitle}
  railText={policy.railText}
>
  {sections.map((section, index) => (
    <section class="legal-section" id={section.id}>
      <h2><span>{String(index + 1).padStart(2, '0')}</span>{section.label}</h2>
      <Fragment set:html={render(body.sections[section.id])} />
    </section>
  ))}

  <aside class="legal-note">
    <Fragment set:html={render(body.finalNote ?? '')} />
  </aside>
</LegalPage>
